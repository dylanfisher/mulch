# Clearing a loop mid-play continues from the playhead instead of rewinding to 0:00 —
# rendered offline (`./scripts/drive --render 1`) so the resume offset is arithmetic, not a
# race: a 0.05s lookahead start at offset 3.5, a 0.25s loop, cleared at 0.4 — the replacement
# source starts at 0.45 from 3.5 + (0.4 % 0.25) = 3.65, and runs out at 0.8, inside the render.
# The loop sits at the end of the source rather than at 0.5 because a load carries no length any
# more (P127): what has to run out inside the render is the tail after the loop, not the buffer.
{"t":"deck.load","deck":"a","source":{"gen":"sine","hz":220}}
{"t":"deck.loop","deck":"a","in":3.5,"out":3.75}
{"t":"deck.play","deck":"a"}
{"at":0.4,"cmd":{"t":"deck.loop","deck":"a","in":0,"out":0}}
