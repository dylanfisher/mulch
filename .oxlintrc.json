{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "react-perf",
    "import",
    "promise",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "warn"
  },
  "options": { "typeAware": true },
  "env": { "browser": true, "es2024": true },
  "rules": {
    "typescript/consistent-type-imports": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-unnecessary-condition": "error",
    "react/exhaustive-deps": "error",
    "react/rules-of-hooks": "error",
    "no-empty": ["error", { "allowEmptyCatch": false }],
    "max-lines": ["warn", { "max": 400 }],
    "no-underscore-dangle": ["error", { "allow": ["__MULCH_DRIVE__", "__MULCH_LONG_TASKS__"] }],
    "no-console": ["warn", { "allow": ["warn", "error"] }],

    "react/react-in-jsx-scope": "off",
    "react-perf/jsx-no-jsx-as-prop": "off",
    "import/no-unassigned-import": "off",
    "unicorn/prefer-query-selector": "off",
    "typescript/prefer-readonly-parameter-types": "off"
  },
  "ignorePatterns": ["dist", "coverage", "public/wasm"],
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": { "no-console": "off" }
    },
    {
      // A worker's own postMessage — and a Worker handle's — takes no targetOrigin; that is
      // window's overload, and the rule cannot tell the two apart.
      "files": ["src/workers/**"],
      "env": { "worker": true },
      "rules": { "unicorn/require-post-message-target-origin": "off" }
    },
    {
      // A worklet is untyped by construction: it is plain JavaScript loaded by URL into
      // AudioWorkletGlobalScope, whose globals (AudioWorkletProcessor, registerProcessor,
      // currentTime) exist in no lib the type-aware rules can see, so every line reads as
      // `any`. Its port's postMessage has no targetOrigin either — that is window's.
      "files": ["src/audio/worklets/**"],
      "env": { "worker": true },
      "rules": {
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "unicorn/require-post-message-target-origin": "off"
      }
    },
    {
      // The browser half of ./scripts/smoke is a Playwright fixture, not app code. Everything it
      // reads comes back through `page.evaluate` as `any` — `window.mulch` is a runtime facade no
      // lib describes — so the type-aware rules see nothing but unsafe access, exactly as they do
      // in a worklet. The rest are shapes a fixture wants and a component does not: an evaluate
      // argument named for the outer value it carries, a sequence of scenarios that must await in
      // order, and one file per scenario that is one long function on purpose.
      "files": ["scripts/smoke.d/**"],
      "rules": {
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unnecessary-condition": "off",
        "typescript/strict-boolean-expressions": "off",
        "typescript/unbound-method": "off",
        // An IndexedDB request rejects with its own DOMException, which the rule cannot see is one.
        "typescript/prefer-promise-reject-errors": "off",
        "unicorn/consistent-function-scoping": "off",
        "unicorn/no-array-sort": "off",
        "import/max-dependencies": "off",
        "no-await-in-loop": "off",
        "no-shadow": "off",
        "no-unused-vars": ["error", { "ignoreRestSiblings": true }],
        "max-lines-per-function": "off"
      }
    },
    {
      // The profiler's comparison reads runs back out of a JSONL file on disk, so every record it
      // judges arrives as `any` and stays one — the same shape the smoke's fixtures are in, for the
      // same reason: there is no type at the boundary because the boundary is a file.
      "files": ["scripts/profile.d/**"],
      "rules": {
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/strict-boolean-expressions": "off"
      }
    },
    {
      "files": ["src/ui/components/**"],
      "rules": {
        "eqeqeq": "off",
        "no-underscore-dangle": "off",
        "jsx-a11y/label-has-associated-control": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "react/jsx-no-constructed-context-values": "off",
        "react/no-array-index-key": "off",
        // A generated `render = <Button …/>` default: the slot a caller overrides, written the
        // way shadcn writes it. An edit here would be lost on the next `shadcn add` (0003).
        "react/no-object-type-as-default-prop": "off",
        "react-perf/jsx-no-new-function-as-prop": "off",
        "react-perf/jsx-no-new-object-as-prop": "off",
        "typescript/no-unnecessary-condition": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/prefer-nullish-coalescing": "off",
        "typescript/strict-boolean-expressions": "off",
        "unicorn/explicit-length-check": "off"
      }
    }
  ]
}
