#!/usr/bin/env bash
# Measure at the end of a feature, which is what a push is.
#
# ./scripts/check runs per change and asserts on counts. This runs per push and measures the
# continuous numbers the gate refuses to assert on, comparing them against this machine's own
# recorded runs ([0051](../docs/decisions/0051-the-profiler-remembers-its-own-runs.md)).
#
# It cannot fail a push. Not "does not by default" — cannot: the exit is a literal 0 on the last
# line. A hook that can block a push is a hook that gets --no-verify'd, and a skipped hook records
# nothing, which leaves the history too thin for the next comparison to mean anything. The whole
# mechanism depends on being ignorable.
#
#   MULCH_NO_PROFILE=1 git push    skip it entirely (a hotfix, a plane, a dead battery)
set -uo pipefail
cd "$(dirname "$0")/.."

if [ -n "${MULCH_NO_PROFILE:-}" ]; then
  printf '\033[2mpre-push: profiling skipped (MULCH_NO_PROFILE).\033[0m\n'
  exit 0
fi

# A push can come from somewhere that never sourced a shell profile — a GUI client, an editor's
# source-control panel — and a version manager keeps node in a per-shell directory that only that
# profile puts on PATH. Look where the manager keeps its default before giving up, and if there is
# still no node, skip: this hook measures, and a measurement missed is not a push worth blocking.
if ! command -v node >/dev/null 2>&1; then
  for bin in \
    "${FNM_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/fnm}/aliases/default/bin" \
    "$HOME/Library/Application Support/fnm/aliases/default/bin" \
    /opt/homebrew/bin \
    /usr/local/bin; do
    if [ -x "$bin/node" ]; then
      PATH="$bin:$PATH"
      break
    fi
  done
fi

if ! command -v node >/dev/null 2>&1; then
  printf '\033[2mpre-push: profiling skipped (no node on PATH).\033[0m\n'
  exit 0
fi

# Git feeds the pushed refs on stdin. Nothing below reads them, and leaving the pipe attached
# would hand it to a child that might.
./scripts/profile --compare </dev/null
measured=$?

# A flagged number and a profiler that could not run are both exit-0 to this hook, and they are
# not the same thing: the first is the mechanism working and the second is no measurement at all,
# with nothing appended to the history. --compare exits 0 whatever it FINDS, so a non-zero here is
# a crash or the deadline — say which, because the next comparison is now reading a thinner
# history and the run after it will not know why. Still exit 0; see the header.
if [ "$measured" -ne 0 ]; then
  printf '\033[31mpre-push: the profiler did not finish (exit %s) — nothing was recorded.\033[0m\n' "$measured"
  printf '\033[2mThe push is not blocked. Run ./scripts/profile --compare to see it fail.\033[0m\n'
fi

# Deliberate, and the reason this file exists at all. See the header.
exit 0
