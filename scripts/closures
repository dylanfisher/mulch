#!/usr/bin/env node
// A closure handed to the page carries nothing from the module around it. `page.evaluate(fn)`
// serializes `fn` to source text and runs it in the browser, where this file's imports do not
// exist — so a constant referenced inside one is a ReferenceError at run time and nothing at
// build time. The gate cannot catch it by running: ./scripts/smoke drives its own closures, but
// ./scripts/profile is not in the gate, and P127 shipped a `GEN_SECS` inside one that broke the
// profiler outright while ./scripts/check stayed green for a whole step.
//
// The repair the repo already uses is to pass the value as the second argument, which stays on
// the Node side and may reference whatever it likes. So only the FIRST argument is scanned.
import { readdirSync, readFileSync } from "node:fs";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), "..");
const SCRIPTS = join(ROOT, "scripts");

/** Every JS file under scripts/, extension or shebang — the executables carry neither. */
const sources = () => {
  const out = [];
  const walk = (dir) => {
    for (const entry of readdirSync(dir, { withFileTypes: true })) {
      const path = join(dir, entry.name);
      if (entry.isDirectory()) {
        walk(path);
        continue;
      }
      if (entry.name.endsWith(".json") || entry.name.endsWith(".md")) continue;
      const text = readFileSync(path, "utf8");
      if (entry.name.endsWith(".js") || text.startsWith("#!/usr/bin/env node")) {
        out.push([path, text]);
      }
    }
  };
  walk(SCRIPTS);
  return out;
};

/**
 * The names this module's imports bind. `import x, { a, b as c } from` binds x, a and c — the
 * local name is what a closure body would spell, so `as` takes the right-hand side.
 */
const importedNames = (text) => {
  const names = new Set();
  for (const match of text.matchAll(/^import\s+([^;]+?)\s+from\s+["'][^"']+["']/gmu)) {
    const clause = match[1];
    const braces = clause.match(/\{([^}]*)\}/u);
    if (braces) {
      for (const part of braces[1].split(",")) {
        const name = part.trim().split(/\s+as\s+/u).pop()?.trim();
        if (name) names.add(name);
      }
    }
    const bare = clause.replace(/\{[^}]*\}/u, "").replace(/^\s*,|,\s*$/gu, "").trim();
    for (const part of bare.split(",")) {
      const name = part.trim().replace(/^\*\s+as\s+/u, "");
      if (name && /^[A-Za-z_$][\w$]*$/u.test(name)) names.add(name);
    }
  }
  return names;
};

/**
 * From the open paren of a call, the source span of its first argument. Scans balanced, stopping
 * at the top-level comma that ends the first argument — which is exactly the boundary between
 * what runs in the page and what stays here. Strings, templates and comments are skipped so a
 * selector holding a brace or a comma cannot move it.
 */
const firstArgument = (text, open) => {
  let depth = 0;
  for (let i = open; i < text.length; i++) {
    const c = text[i];
    if (c === "/" && text[i + 1] === "/") {
      i = text.indexOf("\n", i);
      if (i === -1) break;
      continue;
    }
    if (c === "/" && text[i + 1] === "*") {
      i = text.indexOf("*/", i + 2) + 1;
      if (i === 0) break;
      continue;
    }
    if (c === '"' || c === "'" || c === "`") {
      const quote = c;
      i++;
      while (i < text.length && text[i] !== quote) i += text[i] === "\\" ? 2 : 1;
      continue;
    }
    if (c === "(" || c === "[" || c === "{") depth++;
    else if (c === ")" || c === "]" || c === "}") {
      depth--;
      if (depth === 0) return text.slice(open + 1, i);
    } else if (c === "," && depth === 1) return text.slice(open + 1, i);
  }
  return null;
};

/** A span with its strings, templates and comments blanked, so neither can hide an identifier. */
const bareText = (span) =>
  span
    .replace(/\/\/[^\n]*/gu, " ")
    .replace(/\/\*[\s\S]*?\*\//gu, " ")
    .replace(/`(?:\\.|[^`\\])*`/gu, " ")
    .replace(/"(?:\\.|[^"\\])*"/gu, " ")
    .replace(/'(?:\\.|[^'\\])*'/gu, " ");

/** The identifiers a span spells, skipping anything after a dot — those are property names. */
const identifiersIn = (bare) => {
  const found = new Set();
  for (const match of bare.matchAll(/(\.)?\b([A-Za-z_$][\w$]*)\b/gu)) {
    if (!match[1]) found.add(match[2]);
  }
  return found;
};

/**
 * The names the closure binds for itself, which shadow the module around it and are therefore
 * fine. Two sources: every parameter list — the outer one and each nested arrow's, since a
 * parameter named after an import is the repo's own way of handing a constant in through
 * evaluate's second argument — and every declaration head in the body.
 */
const boundIn = (bare) => {
  const bound = new Set();
  // Walk back from each arrow: either a balanced (…) group or one bare identifier.
  for (const arrow of [...bare.matchAll(/=>/gu)].map((m) => m.index)) {
    let i = arrow - 1;
    while (i >= 0 && /\s/u.test(bare[i])) i--;
    if (bare[i] === ")") {
      let depth = 0;
      for (; i >= 0; i--) {
        if (bare[i] === ")") depth++;
        else if (bare[i] === "(") {
          depth--;
          if (depth === 0) break;
        }
      }
      if (i < 0) continue;
      for (const name of identifiersIn(bare.slice(i, arrow))) bound.add(name);
    } else {
      const single = bare.slice(0, i + 1).match(/([A-Za-z_$][\w$]*)\s*$/u);
      if (single) bound.add(single[1]);
    }
  }
  // `function (a, b)` has no arrow; so does `catch (err)`.
  for (const match of bare.matchAll(/\b(?:function\s*[\w$]*|catch)\s*\(([^)]*)\)/gu)) {
    for (const name of identifiersIn(match[1])) bound.add(name);
  }
  // Declaration heads, destructuring patterns included: everything up to `=` or the terminator.
  for (const match of bare.matchAll(/\b(?:const|let|var)\s+([^=;\n]+)/gu)) {
    for (const name of identifiersIn(match[1])) bound.add(name);
  }
  for (const match of bare.matchAll(/\b(?:function|class)\s+([A-Za-z_$][\w$]*)/gu)) {
    bound.add(match[1]);
  }
  return bound;
};

const bad = [];
for (const [path, text] of sources()) {
  const imported = importedNames(text);
  if (imported.size === 0) continue;
  for (const match of text.matchAll(/\.evaluate(?:Handle)?\s*\(/gu)) {
    const open = match.index + match[0].length - 1;
    const span = firstArgument(text, open);
    if (span === null) continue;
    const bare = bareText(span);
    const bound = boundIn(bare);
    for (const name of identifiersIn(bare)) {
      if (!imported.has(name) || bound.has(name)) continue;
      const line = text.slice(0, open).split("\n").length;
      bad.push(`${path.slice(ROOT.length + 1)}:${line}  ${name}`);
    }
  }
}

if (bad.length > 0) {
  console.error(
    "A closure handed to the page referenced an import of the file around it. It is serialized to\n" +
      "source and run in the browser, where that binding does not exist — pass it as evaluate's\n" +
      "second argument instead, which stays on this side.\n",
  );
  for (const line of bad) console.error(`  ${line}`);
  process.exit(1);
}

console.log(`${sources().length} scripts, no page closure reaches its module`);
