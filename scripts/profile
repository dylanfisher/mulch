#!/usr/bin/env node
// The diagnostic half of the browser work — the numbers ./scripts/check deliberately does not
// assert on. Everything here is a threshold that moves with the machine, the collector's mood and
// whatever else was running, which is exactly what must not decide whether a gate is green: a
// flaky step gets blessed away and takes the honest coverage beside it with it. So this prints and
// judges nothing. The assertions that ARE stable live in scripts/smoke.d/leaks.js and
// scripts/smoke.d/longTasks.js, in the gate, as booleans.
//
//   ./scripts/profile                 every section, against the cached preview build
//   ./scripts/profile --cycles 50     how many rack add/remove rounds to churn (default 20)
//   ./scripts/profile --heap          also write a .heapsnapshot to open in DevTools › Memory
//   ./scripts/profile --heap PATH     ...at a path you choose
//   ./scripts/profile --cpu           also record a CPU profile across the cycles, top frames out
//
// A snapshot defaults into the system temp directory and never into the repo: it is a photograph
// of one run on one machine, and the moment one is committed someone will diff against it as
// though it were a golden. It is not. Nothing here has a golden, and there is no --bless.
//
// What there is instead is a memory of this machine's own runs, in .profile-history.jsonl —
// gitignored, appended to by every clean run, and never compared across machines
// ([0051](../docs/decisions/0051-the-profiler-remembers-its-own-runs.md)). That is what turns a
// number into a regression: 19.4x means nothing, 19.4x against a median of 31.0x means something.
//
// The comparison prints by default, because the run it is attached to is worth half a minute and
// the verdict on it was worth a flag nobody remembered to pass.
//
//   --no-compare      measure and print the sections, and say nothing about the trend
//   --compare         accepted and ignored; the comparison is the default
//   --json            print the run's record to stdout and nothing else, for piping
//   --no-record       measure without appending to the history
//   --accept WHY      record this run as the new baseline, forgetting everything before it
//
// --accept is for the regression a human read and kept. A cost that was measured, attributed and
// decided against fixing is the new normal, but the band does not know that: it is the last ten
// runs, so for ten runs afterwards every honest commit is flagged for the change before it, and
// whoever is running the profiler spends those ten proving something already in the record. That
// happened for three commits straight in one run, at a dozen interleaved runs apiece. Accepting a
// number says so once, in the history, with the reason attached.
//
// The comparison exits 0 whatever it finds, always. The moment it can fail a push it gets skipped
// with --no-verify, and then there is no history at all — see the flake argument above, which is
// the same argument. It flags, a human reads, a human decides.
//
// The build in dist/ is reused when src/ has not changed since it and rebuilt when it has, the
// same rule ./scripts/drive follows. --fresh rebuilds unconditionally, for when the build is what
// you distrust.
//
//   --fresh           rebuild before profiling, whatever the mtimes say
//   --deadline SECS   move the deadline (default 120, 0 removes it)
//
// Nothing here may hang, for the reason nothing in scripts/drive may
// ([0036](../docs/decisions/0036-the-harness-fails-by-a-clock.md)): a run that outlives the
// patience of whoever started it is worth less than the same run dying at a clock and naming the
// stage it was stuck in.
import { execFileSync } from "node:child_process";
import { existsSync, readdirSync, readFileSync, statSync } from "node:fs";
import { appendFile, writeFile } from "node:fs/promises";
import { tmpdir } from "node:os";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";

import { GEN_SECS } from "../src/lib/waveform.ts";
import { paint, trendLines, verdictLine, wantsColour, WINDOW } from "./profile.d/trend.js";
import { openPage } from "./smoke.d/page.js";

const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), "..");

const args = process.argv.slice(2);
const die = (message) => {
  console.error(`profile: ${message}`);
  process.exit(1);
};
const flag = (name) => {
  const index = args.indexOf(name);
  if (index === -1) return false;
  args.splice(index, 1);
  return true;
};
const option = (name) => {
  const index = args.indexOf(name);
  if (index === -1) return undefined;
  const [, value] = args.splice(index, 2);
  if (value === undefined) die(`${name} needs a value`);
  return value;
};
// --heap takes an optional path, so it is read as a value first and demoted to a bare flag when
// what follows is another flag or nothing at all.
const heapAt = args.indexOf("--heap");
let heapPath;
let heap = false;
if (heapAt !== -1) {
  heap = true;
  const next = args[heapAt + 1];
  heapPath = next !== undefined && !next.startsWith("-") ? next : undefined;
  args.splice(heapAt, heapPath === undefined ? 1 : 2);
}

const cpu = flag("--cpu");
const fresh = flag("--fresh");
const json = flag("--json");
// Kept so every habit, hook and doc that types it still works — the comparison it used to ask for
// is now what happens anyway, and a flag that errors is a worse answer than a flag that agrees.
flag("--compare");
const compare = !flag("--no-compare") && !json;
const noRecord = flag("--no-record");
const acceptWhy = option("--accept");
const cyclesOption = option("--cycles");
const deadlineOption = option("--deadline");
const unknown = args.find((argument) => argument.startsWith("-"));
if (unknown) die(`unknown flag: ${unknown}`);
if (args.length > 0) die(`unexpected argument: ${args[0]}`);
// A baseline nobody wrote down is the thing --accept exists to replace, so it refuses to be a bare
// flag, and it cannot be accepted into a history it is not being written to.
if (acceptWhy !== undefined && acceptWhy.trim() === "") die("--accept needs a reason");
if (acceptWhy !== undefined && noRecord) die("--accept records; it cannot take --no-record");
// Same reason --cpu and --heap are never recorded: they cost the run time the code did not. A
// baseline every later run is judged against is the last place that belongs.
if (acceptWhy !== undefined && (cpu || heap)) die("--accept cannot take --cpu or --heap");

const CYCLES = cyclesOption === undefined ? 20 : Number(cyclesOption);
if (!(CYCLES > 0)) die(`--cycles needs a positive count: ${cyclesOption}`);
const DEADLINE_SECS = deadlineOption === undefined ? 120 : Number(deadlineOption);
if (!(DEADLINE_SECS >= 0)) die(`--deadline needs seconds: ${deadlineOption}`);

// The stage name is the whole point of the deadline: "profile gave up" says nothing a second run
// would not have to discover again.
let stage = "starting up";
const at = (next) => {
  stage = next;
};
if (DEADLINE_SECS > 0) {
  setTimeout(() => {
    console.error(`profile: deadline of ${DEADLINE_SECS}s reached while ${stage}`);
    process.exit(1);
  }, DEADLINE_SECS * 1_000).unref();
}

/** Newest mtime under the paths that shape the build — the same set ./scripts/drive watches. */
const newestSource = () => {
  const newest = (path) => {
    const stat = statSync(path);
    if (!stat.isDirectory()) return stat.mtimeMs;
    return Math.max(stat.mtimeMs, ...readdirSync(path).map((entry) => newest(join(path, entry))));
  };
  return Math.max(
    ...["src", "index.html", "vite.config.ts", "package.json", "pnpm-lock.yaml"]
      .map((path) => join(ROOT, path))
      .filter((path) => existsSync(path))
      .map(newest),
  );
};

// Unlike scripts/smoke, nothing here builds by reflex, and profiling a stale bundle is not a
// harmless mistake: it reports the previous code's numbers under this code's name. That has
// already happened once during this script's own development — a deliberately leaky build left in
// dist/ made a healthy rack read as leaking one node per cycle, convincingly, three times. So the
// same check ./scripts/drive makes, for the same reason, and it says which it did.
const built = join(ROOT, "dist/index.html");
if (fresh || !existsSync(built) || statSync(built).mtimeMs < newestSource()) {
  at("building the app");
  console.error("profile: building (src is newer than dist)…");
  const { build } = await import("vite");
  await build({ root: ROOT, logLevel: "warn" });
} else {
  console.error("profile: reusing the build in dist/ (src has not changed since it)");
}

// ---- printing ----
//
// All three go quiet under --json so stdout carries one parseable object and nothing else. The
// build's own chatter above already goes to stderr, which is why it needs no guard.

// Escapes are for a terminal. A piped run is plain, so `| grep`, `| cat` and a scrollback pasted
// into a report all read as what was printed rather than as what was painted.
const COLOUR = !json && wantsColour(process.env, process.stdout);
const { ok, bad, dim, bold } = paint(COLOUR);

const say = (line) => {
  if (!json) console.log(line);
};
const section = (title) => say(`\n${bold(`▸ ${title}`)}`);
const row = (label, value) => say(`  ${label.padEnd(26)} ${value}`);
/** The same row with a verdict in front of it. The label is padded before the icon is painted, so
 * an escape code never counts toward the column the eye is following. */
const marked = (icon, label, value) => say(`  ${icon} ${label.padEnd(24)} ${value}`);
const note = (text) => say(`  ${dim(text)}`);
const signed = (delta) => (delta > 0 ? `+${delta}` : String(delta));
/** ✓ when a count came back to where it started, ✗ when it did not. The vocabulary is
 * scripts/check's, so a green run looks the same wherever this repo prints one. */
const mark = (clean) => (clean ? ok("✓") : bad("✗"));

// ---- the history ----

const HISTORY = join(ROOT, ".profile-history.jsonl");

/**
 * Which commit produced these numbers, so a flagged run can be bisected instead of re-argued.
 * Dirty is worth saying: uncommitted work is the most likely explanation for a number that moved,
 * and the least likely thing to still be there tomorrow.
 */
const revision = () => {
  try {
    const git = (...argv) => execFileSync("git", argv, { cwd: ROOT, encoding: "utf8" }).trim();
    return `${git("rev-parse", "--short", "HEAD")}${git("status", "--porcelain") === "" ? "" : "-dirty"}`;
  } catch {
    return null;
  }
};

/**
 * Past runs worth comparing this one against: same cycle count, since churn wall clock scales with
 * it, and clean, since --cpu and --heap both cost time the code did not. A malformed line is
 * skipped rather than fatal — the file is an append log on a developer's machine, and one truncated
 * write must not cost the other nine runs.
 */
const readHistory = () => {
  if (!existsSync(HISTORY)) return [];
  const runs = [];
  for (const line of readFileSync(HISTORY, "utf8").split("\n")) {
    if (line.trim() === "") continue;
    try {
      const run = JSON.parse(line);
      if (run.cycles === CYCLES) runs.push(run);
    } catch {
      continue;
    }
  }
  // An accepted run is where the past starts. Everything before it was measured against a cost
  // this machine has since decided to carry, so comparing against it flags the decision rather
  // than the code — and keeps flagging it for a whole window. The accepted run itself is kept as
  // the first of the new baseline, because it is the first honest sample of the new normal.
  const rebased = runs.findLastIndex((run) => typeof run.accepted === "string");
  return (rebased === -1 ? runs : runs.slice(rebased)).slice(-WINDOW);
};

// ---- the CDP reads, each one the same shape the smoke's leak scenario uses ----

const liveCount = async (cdp, expression) => {
  const { result } = await cdp.send("Runtime.evaluate", { expression });
  let objects;
  try {
    ({ objects } = await cdp.send("Runtime.queryObjects", { prototypeObjectId: result.objectId }));
    const counted = await cdp.send("Runtime.callFunctionOn", {
      objectId: objects.objectId,
      functionDeclaration: "function () { return this.length }",
      returnByValue: true,
    });
    return counted.result.value;
  } finally {
    // The query array holds everything it found. Unreleased, it is the retainer that makes the
    // next count wrong — see scripts/smoke.d/leaks.js, where the same `finally` guards the gate.
    if (objects !== undefined) {
      await cdp.send("Runtime.releaseObject", { objectId: objects.objectId });
    }
    await cdp.send("Runtime.releaseObject", { objectId: result.objectId });
  }
};

/**
 * What the churn adds and removes each cycle. `filter` and `delay` are linear and untinted, so
 * every run before P107 painted the drift's cheap path and nothing else — no profiler run baked a
 * picture-sized tile at all, which is the gap P103 recorded. `reverb` is the curved, tinted entry
 * that makes the painter's expensive path measurable: its rows are rings about an anchor and its
 * tone is a step of the picture's own colour (0141, 0142).
 */
const CHURNED = ["filter", "delay", "reverb"];

/** Everything a rack churn plausibly strands, including the ones the gate refuses to assert on. */
const PROTOTYPES = [
  "BiquadFilterNode.prototype",
  "DelayNode.prototype",
  "ConvolverNode.prototype",
  "GainNode.prototype",
  "AudioBufferSourceNode.prototype",
  "AudioBuffer.prototype",
  "Float32Array.prototype",
];

const COUNTERS = [
  "Nodes",
  "JSEventListeners",
  "Documents",
  "JSHeapUsedSize",
  "LayoutCount",
  "RecalcStyleCount",
];

const metrics = async (cdp) => {
  const { metrics: read } = await cdp.send("Performance.getMetrics");
  return Object.fromEntries(read.map((entry) => [entry.name, entry.value]));
};

const liveObjects = async (cdp) => {
  const counts = {};
  for (const expression of PROTOTYPES) counts[expression] = await liveCount(cdp, expression);
  return counts;
};

const main = async () => {
  at("opening the preview build");
  const session = await openPage(ROOT);
  const { page } = session;
  const cdp = await page.context().newCDPSession(page);

  try {
    at("loading a source");
    await page.locator('input[aria-label="Import Audio for Yard A"]').setInputFiles({
      name: "profile.wav",
      mimeType: "audio/wav",
      buffer: Buffer.from(session.bytes.wav),
    });
    await page.waitForFunction(() => window.mulch.probe().decks.a.duration > 0);

    await cdp.send("Performance.enable");
    await cdp.send("HeapProfiler.enable");
    await cdp.send("HeapProfiler.collectGarbage");
    const before = { counters: await metrics(cdp), objects: await liveObjects(cdp) };

    at("watching for long tasks");
    await page.evaluate(() => {
      window.__MULCH_LONG_TASKS__ = [];
      new PerformanceObserver((list) => {
        for (const entry of list.getEntries()) window.__MULCH_LONG_TASKS__.push(entry.duration);
      }).observe({ type: "longtask" });
    });

    if (cpu) await cdp.send("Profiler.enable");
    if (cpu) await cdp.send("Profiler.start");

    at(`churning ${CYCLES} rack cycles`);
    const held = await page.evaluate(() => window.mulch.probe().decks.a.effects.length);
    const churnStarted = Date.now();
    for (let cycle = 0; cycle < CYCLES; cycle += 1) {
      const adds = CHURNED.map((effect) => ({ effect, id: `profile-${cycle}-${effect}` }));
      const ids = adds.map((one) => one.id);
      await page.evaluate((instances) => {
        for (const { effect, id } of instances) {
          window.mulch.send({ t: "effect.add", deck: "a", effect, id });
        }
      }, adds);
      await page.waitForFunction(
        (expected) => window.mulch.probe().decks.a.effects.length === expected,
        held + CHURNED.length,
      );
      await page.evaluate((instances) => {
        for (const instance of instances) {
          window.mulch.send({ t: "effect.remove", deck: "a", instance });
        }
      }, ids);
      await page.waitForFunction(
        (expected) => window.mulch.probe().decks.a.effects.length === expected,
        held,
      );
    }
    const churnMs = Date.now() - churnStarted;

    let profile = null;
    if (cpu) ({ profile } = await cdp.send("Profiler.stop"));

    at("collecting garbage");
    await cdp.send("HeapProfiler.collectGarbage");
    const after = { counters: await metrics(cdp), objects: await liveObjects(cdp) };
    // A second reading, after giving the graph time to actually let go. A Web Audio node's wrapper
    // is released by Blink rather than by the JS heap alone, so a churn that finishes in 50ms and
    // is collected immediately still shows every node it made — which looks exactly like a leak
    // and is not one. The gap between these two columns is that lag, and it is the whole reason
    // scripts/smoke.d/leaks.js polls instead of asserting once.
    at("letting the graph settle");
    await page.waitForTimeout(1_000);
    await cdp.send("HeapProfiler.collectGarbage");
    const settled = { counters: await metrics(cdp), objects: await liveObjects(cdp) };

    // ---- counters ----
    section(
      `counters, across ${CYCLES} rack add/remove cycles (${churnMs}ms) — before, after, settled`,
    );
    for (const name of COUNTERS) {
      const from = before.counters[name];
      const to = after.counters[name];
      if (from === undefined) {
        row(name, dim("not reported by this Chromium"));
        continue;
      }
      const rest = settled.counters[name];
      const scale = name === "JSHeapUsedSize" ? 1 / 1_048_576 : 1;
      const unit = name === "JSHeapUsedSize" ? " MB" : "";
      const fixed = (value) => (scale === 1 ? String(value) : (value * scale).toFixed(2));
      // Nothing here carries a ✓ or a ✗, and the temptation to add one is the whole note below.
      // Three of these six only ever climb, a heap between collections is meant to be higher than
      // it was, and a healthy 20-cycle run settles a single-digit number of nodes above where it
      // started — so a mark on any of them would be a mark on every honest run.
      const growth = rest - from;
      row(
        name,
        `${fixed(from)}${unit} → ${fixed(to)}${unit} → ${fixed(rest)}${unit}  ` +
          `${dim(`(${growth > 0 ? "+" : ""}${fixed(growth)}${unit} settled)`)}`,
      );
    }
    note("read the settled column and not the middle one, for the reason the live objects");
    note("below say. Layout and style recalcs are running totals that never fall, and a");
    note("handful of nodes either way is the page being a page — scripts/smoke.d/leaks.js");
    note("is where a count becomes an assertion, at a slack these numbers have no business");
    note("restating.");

    // ---- live objects ----
    section("live objects by prototype — before, straight after, and once settled");
    for (const expression of PROTOTYPES) {
      const from = before.objects[expression];
      const to = after.objects[expression];
      const rest = settled.objects[expression];
      const name = expression.replace(".prototype", "");
      const stranded = rest - from;
      // AudioBuffer is exempt because the decode cache is holding it on purpose, which is the same
      // reason the gate does not assert on it either — see the note below.
      const held = name === "AudioBuffer";
      marked(
        held ? dim("·") : mark(stranded === 0),
        name,
        `${from} → ${to} → ${rest}  (${
          held || stranded === 0 ? dim(`${signed(stranded)} settled`) : bad(`${signed(stranded)} settled`)
        })`,
      );
    }
    note("the middle column trails: Blink releases an audio node's wrapper a render");
    note("quantum or two after the JS side drops it, so only the last column means");
    note("anything. A real leak does not move between the last two.");
    note("AudioBuffer is held on purpose by the decode cache (DECODE_CACHE_LIMIT),");
    note("which is why the gate does not assert on it.");

    // ---- render capacity ----
    at("measuring render capacity");
    section("render capacity, during real playback");
    const capacity = await page.evaluate(async () => {
      const context = new AudioContext();
      if (!("renderCapacity" in context)) {
        await context.close();
        return null;
      }
      const updates = [];
      context.renderCapacity.onupdate = (event) => {
        updates.push({
          averageLoad: event.averageLoad,
          peakLoad: event.peakLoad,
          underrunRatio: event.underrunRatio,
        });
      };
      context.renderCapacity.start({ updateInterval: 0.2 });
      window.mulch.send({ t: "deck.play", deck: "a" });
      await new Promise((slept) => setTimeout(slept, 1_000));
      window.mulch.send({ t: "deck.stop", deck: "a" });
      context.renderCapacity.stop();
      await context.close();
      return updates;
    });
    // Recorded but never compared: a null sink can report a flat zero forever, and a metric that
    // cannot move is a metric whose median says nothing. It is in the record so that the day
    // headless grows a real sink there is already a history to read.
    let peakLoad = null;
    if (capacity === null) {
      row("renderCapacity", "unsupported in this Chromium");
    } else if (capacity.length === 0) {
      row("renderCapacity", "supported, but reported no updates");
    } else {
      const worst = (key) => Math.max(...capacity.map((update) => update[key]));
      peakLoad = worst("peakLoad");
      row("averageLoad (max seen)", worst("averageLoad").toFixed(4));
      row("peakLoad (max seen)", peakLoad.toFixed(4));
      row("underrunRatio (max seen)", worst("underrunRatio").toFixed(4));
      note("headless renders to a null sink, so a zero here may be vacuous — read it");
      note("before trusting it, which is why it is not a gate assertion.");
    }

    // ---- frame cost ----
    at("sampling frame cost");
    section("frame cost, over 60 frames");
    const frames = await page.evaluate(
      () =>
        new Promise((done) => {
          const samples = [];
          let last = performance.now();
          const tick = () => {
            const now = performance.now();
            samples.push(now - last);
            last = now;
            if (samples.length < 60) requestAnimationFrame(tick);
            else done(samples);
          };
          requestAnimationFrame(tick);
        }),
    );
    const sorted = [...frames].sort((a, b) => a - b);
    const mean = frames.reduce((sum, value) => sum + value, 0) / frames.length;
    const framePct95 = sorted[Math.floor(sorted.length * 0.95)];
    row("min / mean / p95", `${sorted[0].toFixed(1)} / ${mean.toFixed(1)} / ` +
      `${framePct95.toFixed(1)} ms`);

    // ---- long tasks ----
    section("long tasks, since the churn began");
    const longTasks = await page.evaluate(() => window.__MULCH_LONG_TASKS__);
    // Zero, not null, when the thread was never held: "no long task" is a real measurement and
    // belongs in the median as one, where a null would quietly shrink the sample instead.
    const longestTaskMs = longTasks.length === 0 ? 0 : Math.max(...longTasks);
    if (longTasks.length === 0) {
      marked(ok("✓"), "none", dim("the main thread was never held past 50ms"));
    } else {
      for (const [index, duration] of longTasks.entries()) {
        marked(bad("✗"), `#${index + 1}`, `${duration.toFixed(0)}ms`);
      }
    }

    // ---- realtime factor ----
    at("rendering offline");
    section("offline render, wall clock against rendered time");
    const RENDER_SECS = 2;
    const renderStarted = Date.now();
    await page.evaluate(
      // Both numbers cross into the page as one argument: the closure runs in the browser, where
      // nothing this file imports exists.
      async ({ secs, from }) =>
        await window.mulch.render({
          secs,
          envelopes: [
            { t: "deck.load", deck: "a", source: { gen: "click-train", hz: 8 } },
            // A load carries no length any more (P127), so the pass starts one second from the
            // end of the one length a drawn source has: the same second of clicks and the same
            // silence after it this scenario has always rendered, so the runs 0051 remembers are
            // still runs of this workload.
            { t: "deck.seek", deck: "a", position: from },
            { t: "deck.play", deck: "a" },
          ],
        }),
      { secs: RENDER_SECS, from: GEN_SECS - 1 },
    );
    const renderMs = Date.now() - renderStarted;
    const realtimeFactor = (RENDER_SECS * 1_000) / renderMs;
    row("wall / rendered", `${renderMs}ms for ${RENDER_SECS}s of audio`);
    row("realtime factor", `${realtimeFactor.toFixed(1)}x`);

    // ---- cpu profile ----
    if (profile !== null) {
      section("CPU profile, hottest self time across the churn");
      const total = new Map();
      const hits = profile.samples ?? [];
      const byId = new Map(profile.nodes.map((node) => [node.id, node]));
      for (const id of hits) {
        const node = byId.get(id);
        if (node === undefined) continue;
        const frame = node.callFrame;
        const key = `${frame.functionName || "(anonymous)"} ${frame.url.split("/").pop()}:${frame.lineNumber}`;
        total.set(key, (total.get(key) ?? 0) + 1);
      }
      const ranked = [...total.entries()].sort((a, b) => b[1] - a[1]).slice(0, 12);
      if (ranked.length === 0) row("no samples", "the churn was too short to sample");
      for (const [key, count] of ranked) {
        row(`${((count / hits.length) * 100).toFixed(1)}%`, key);
      }
    }

    // ---- heap snapshot ----
    if (heap) {
      at("writing a heap snapshot");
      const path =
        heapPath ?? join(tmpdir(), `mulch-${new Date().toISOString().replace(/[:.]/g, "-")}.heapsnapshot`);
      const chunks = [];
      const collect = ({ chunk }) => chunks.push(chunk);
      cdp.on("HeapProfiler.addHeapSnapshotChunk", collect);
      await cdp.send("HeapProfiler.takeHeapSnapshot", { reportProgress: false });
      cdp.off("HeapProfiler.addHeapSnapshotChunk", collect);
      const text = chunks.join("");
      await writeFile(path, text);
      section("heap snapshot");
      row("written", path);
      row("size", `${(text.length / 1_048_576).toFixed(1)} MB`);
      note("open it in Chrome DevTools › Memory › Load, and diff two of them");
      note("by hand. It is one run on one machine, never a baseline.");
    }

    // ---- the record ----
    //
    // Assembled last because every field above had to be measured first, and kept flat because the
    // comparison reads it by key. Deltas rather than absolutes for anything the page was already
    // holding before the churn: what a rack costs is the question, not what a boot cost.
    const record = {
      at: new Date().toISOString(),
      sha: revision(),
      cycles: CYCLES,
      ...(acceptWhy === undefined ? {} : { accepted: acceptWhy }),
      metrics: {
        realtimeFactor,
        // The wall clock the factor above is derived from, kept so a flagged run can be read in
        // whole milliseconds — where a move of one is visibly one step of rounding rather than a
        // percentage that looks like a regression. Recorded, not tracked: it says the same thing.
        renderMs,
        churnMs,
        framePct95,
        frameMean: mean,
        heapDeltaMb:
          (settled.counters.JSHeapUsedSize - before.counters.JSHeapUsedSize) / 1_048_576,
        longestTaskMs,
        longTaskCount: longTasks.length,
        peakLoad,
        settled: Object.fromEntries(
          PROTOTYPES.map((expression) => [
            expression.replace(".prototype", ""),
            settled.objects[expression] - before.objects[expression],
          ]),
        ),
      },
    };

    const past = compare ? readHistory() : [];
    if (compare) {
      for (const line of trendLines(record, past, { cycles: CYCLES, colour: COLOUR })) say(line);
    }

    // --cpu and --heap both cost the run time the code did not, so their numbers would poison the
    // median for every honest run after them. They measure, they do not remember.
    if (noRecord || cpu || heap) {
      if (!noRecord) {
        say("");
        note("not recorded: --cpu and --heap cost time the code did not.");
      }
    } else {
      await appendFile(HISTORY, `${JSON.stringify(record)}\n`);
      if (acceptWhy !== undefined) {
        say("");
        note(`baseline reset here: ${acceptWhy}`);
        note("runs before this one are no longer compared against.");
      }
    }

    if (json) console.log(JSON.stringify(record));
    // Dead last, after the notes about what was and was not recorded, because a verdict anywhere
    // else is a verdict something else scrolls past. Everything above it is the working.
    if (compare) {
      say("");
      say(`  ${verdictLine(record, past, { cycles: CYCLES, colour: COLOUR })}`);
    }
    say("");
  } finally {
    at("shutting down");
    await cdp.detach().catch(() => {});
    await session.close();
  }
};

await main();
