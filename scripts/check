#!/usr/bin/env bash
# The gate. Everything must pass before work is considered done.
# Keep this the ONLY command anyone — human or agent — needs to remember.
#
# Every step runs even if an earlier one fails, so one invocation reports every
# problem. Fixing four failures should cost one run, not four.
set -uo pipefail
cd "$(dirname "$0")/.."

# Tools are invoked straight from node_modules/.bin. The `pnpm <bin>` wrapper
# resolves to exactly these binaries but costs ~270ms of process spawn each time,
# which was over a third of this script's runtime. The trade is that a missing
# install turns from a pnpm error into "no such file", so say so plainly instead.
# macOS ships bash 3.2, which has neither $EPOCHREALTIME nor float arithmetic, so
# sub-second timing comes from perl — present on every platform this runs on, and
# ~5ms to spawn the two times it is called. Milliseconds are integers; bash can
# do the arithmetic and printf can put the decimal point back.
now_ms() { perl -MTime::HiRes=time -e 'printf "%.0f\n", time * 1000'; }
started=$(now_ms)

BIN=node_modules/.bin
if [ ! -x "$BIN/oxlint" ]; then
  printf '\033[31m✗ dependencies missing — run ./scripts/setup.\033[0m\n' >&2
  exit 1
fi

logs=$(mktemp -d)
trap 'rm -rf "$logs"' EXIT

steps=()

# run <name> <command...> — start a step in the background, buffering its output.
# Steps are independent and read-only, so ordering bought nothing; running them
# at once is roughly twice as fast. Output is replayed in declaration order once
# all of them finish, so the report stays stable — the cost is that nothing
# streams while it runs, and tools that colourize only for a TTY (oxlint, oxfmt)
# fall back to their plain one-line-per-diagnostic format.
run() {
  local name="$1"; shift
  steps+=("$name")
  ( "$@" >"$logs/$name.log" 2>&1; echo $? >"$logs/$name.rc" ) </dev/null &
}

# AGENTS.md is the highest-leverage file in the repo and the easiest to let rot.
# These are the only rules about it a tool can check; the rest is judgment.
run agents.md bash -c '
  lines=$(wc -l < AGENTS.md | tr -d " ")
  if [ "$lines" -gt 55 ]; then
    echo "AGENTS.md is $lines lines (limit ~50). Move a section to docs/ and link it." >&2; exit 1
  fi
  if grep -q "{{" AGENTS.md; then echo "AGENTS.md has unfilled {{PLACEHOLDER}}s." >&2; exit 1; fi
  if grep -q "NOT YET INITIALIZED" AGENTS.md; then echo "AGENTS.md still has the TEMPLATE block." >&2; exit 1; fi
  echo "$lines lines, no placeholders"
'

# The code map claims where things live. Verify the claim — a rename that misses
# docs/map.md turns it into confident misdirection, which is worse than no map.
run map bash -c '
  if grep -q "{{" docs/map.md; then
    echo "docs/map.md has unfilled {{PLACEHOLDER}}s." >&2; exit 1
  fi
  paths=$(grep "^<!-- paths:" docs/map.md | sed "s/^<!-- paths: //; s/ -->//")
  if [ -z "$paths" ]; then
    echo "docs/map.md is missing its <!-- paths: ... --> line." >&2; exit 1
  fi
  missing=""
  for p in $paths; do [ -e "$p" ] || missing="$missing $p"; done
  if [ -n "$missing" ]; then
    echo "docs/map.md names paths that do not exist:$missing" >&2; exit 1
  fi
  echo "tiers exist: $paths"
'

# A decision is addressed by its number — from plan.md, from another decision, and
# from a bare "(0129)" in a comment. Two files sharing one number make every one of
# those references ambiguous, and the ambiguity is silent: both files exist, every
# link resolves to whichever the reader reaches first. It has happened once, and it
# cost a rename plus eight reference updates to unpick after the fact.
#
# Length is reported and never enforced. The rule is "as long as the decision is and
# not a line longer" (AGENTS.md), which no line count can check — a cap would be a
# proxy the repo never agreed to, and eight decisions already sit past any figure
# worth picking. So the number is put where an author will see it, and the judgment
# stays theirs — as a count and the worst offender rather than the whole list, because
# forty lines of notice on a green gate is the noise a reader learns to scroll past.
run decisions bash -c '
  dupes=$(ls docs/decisions | sed "s/-.*//" | sort | uniq -d)
  if [ -n "$dupes" ]; then
    echo "two decisions share one number, so every reference to it is ambiguous:" >&2
    for n in $dupes; do ls docs/decisions/"$n"-* | sed "s/^/  /" >&2; done
    exit 1
  fi
  total=$(ls docs/decisions/*.md | wc -l | tr -d " ")
  long=$(for f in docs/decisions/*.md; do
    n=$(wc -l < "$f" | tr -d " ")
    [ "$n" -gt 50 ] && echo "$n $(basename "$f")"
  done | sort -rn)
  echo "$total decisions, numbered uniquely"
  if [ -n "$long" ]; then
    count=$(echo "$long" | wc -l | tr -d " ")
    echo "$count past 50 lines, longest $(echo "$long" | head -1 | sed "s/^\([0-9]*\) /\1 lines: /")"
  fi
'

# AGENTS.md stays small by linking instead of restating, so a dead link is not a
# cosmetic problem — it is the pointer to the real instruction going missing.
# `find` rather than `git ls-files` — an uncommitted clone would make the latter
# return nothing and pass silently, which is the failure this whole file exists
# to prevent. Prune dependency trees so the cost stays flat as the project grows.
# NUL-delimited, one line per link: word-splitting a filename or a link that
# contains a space used to invent failures for files nobody linked to, and skip
# the spaced file itself without ever failing the step.
run links bash -c '
  # The walk happens once and lands in a file. Bash cannot hold a NUL-delimited
  # list in a variable, and a second find costs ~170ms — the traversal, not the
  # matching, is what this step pays for.
  list=$(mktemp)
  trap "rm -f \"$list\"" EXIT
  find . -name "*.md" -not -path "./.git/*" \
    -not -path "*/node_modules/*" -not -path "*/vendor/*" -not -path "*/.venv/*" \
    -not -path "*/dist/*" -not -path "*/build/*" -not -path "*/target/*" -print0 > "$list"
  # An ignored path is not part of the repository, so a scratch file under tmp/
  # must not be able to turn the gate red. One batched check-ignore rather than
  # one per file; outside a git repo it prints nothing and everything is read,
  # which is the same conservative failure mode as preferring find above.
  LF="
"
  ignored="$LF$(git check-ignore -z --stdin < "$list" | tr "\0" "\n")$LF"
  bad=""
  found=0
  while IFS= read -r -d "" f; do
    case "$ignored" in *"$LF$f$LF"*) continue ;; esac
    found=$((found + 1))
    while IFS= read -r link; do
      case "$link" in http*|mailto:*|\#*) continue ;; esac
      target="${link%%#*}"
      [ -z "$target" ] && continue
      [ -e "$(dirname "$f")/$target" ] || bad="$bad
    $f → $link"
    done < <(grep -oE "\]\([^)]+\)" "$f" | sed "s/^](//; s/)$//")
  done < "$list"
  if [ "$found" -eq 0 ]; then echo "no markdown found — this check is not looking where it should." >&2; exit 1; fi
  if [ -n "$bad" ]; then echo "markdown links point at nothing:$bad" >&2; exit 1; fi
  echo "all relative links resolve across $found files"
'

# Scaffolding is meant to be torn out, and a half-torn teardown reads as though
# the project were still a template. Dormant until docs/scaffold.md is gone, so
# it never fires on a fresh clone — which also means restoring that file switches
# the step back off. Keep it afterwards anyway: it costs one grep, and it catches
# scaffolding text reintroduced by a copied file or a reverted deletion.
# This file is excluded from the word search — it mentions the term by design —
# so its own leftover is caught by looking for the todo() helper instead.
run residue bash -c '
  if [ -e docs/scaffold.md ]; then echo "not scaffolded yet — skipped"; exit 0; fi
  bad=""
  for f in README.md CLAUDE.md AGENTS.md scripts/setup scripts/dev scripts/test docs/map.md docs/principles.md; do
    [ -e "$f" ] || continue
    grep -qi "scaffold" "$f" && bad="$bad $f"
  done
  # The workflow placeholder says "scaffold" nowhere, and leaving it in keeps CI
  # red forever with no local symptom — so match its text directly.
  if [ -e .github/workflows/check.yml ] && grep -q "no language setup step configured" .github/workflows/check.yml; then
    bad="$bad .github/workflows/check.yml(setup placeholder)"
  fi
  [ -e .claude/commands/scaffold.md ] && bad="$bad .claude/commands/scaffold.md"
  grep -q "^todo()" scripts/check && bad="$bad scripts/check(todo helper)"
  if [ -n "$bad" ]; then
    echo "scaffolding leftovers — see step 9 of the checklist:$bad" >&2; exit 1
  fi
  echo "no leftovers"
'

# oxfmt and oxlint are the oxc (Rust) toolchain; oxlint's type-aware rules run on
# tsgolint, the Go port of the TypeScript compiler — same engine as `tsc` below.
# docs/map.md holds no inventory on purpose, so "does this already exist?" is answered
# by ./scripts/map — which can only answer it if every file carries its one @role line.
# Unenforced, the catalogue is complete on the day it is written and never again.
run roles ./scripts/map --check

run format    $BIN/oxfmt --check .
run lint      $BIN/oxlint
run typecheck $BIN/tsc --noEmit
run arch      ./scripts/arch
# The one thing the browser half cannot catch about itself: ./scripts/smoke drives its own
# closures, so a bad one is red there — but ./scripts/profile is not in the gate and never can
# be (0051: its numbers must not decide whether a gate is green), so a closure it hands the page
# is unrun code until someone profiles. P127 put an import inside one and broke the profiler for
# a whole step under a green gate.
run closures  ./scripts/closures
run test      ./scripts/test
# The end-to-end half of the gate: real preview build, real headless Chromium, the same
# pipe an agent uses. The assertions live in scripts/smoke; the transport is scripts/drive.
run drive     ./scripts/smoke

wait

# Read every result before printing anything, so the verdict can lead as well as
# close. One invocation reports everything, and a reader who pipes this through
# `head` still sees which steps failed rather than a truncated first log.
# A missing .rc means the subshell died without reporting — count it as failed
# rather than letting a killed step read as a pass.
failures=()
for name in "${steps[@]}"; do
  [ "$(cat "$logs/$name.rc" 2>/dev/null || echo 1)" = 0 ] || failures+=("$name")
done

if [ ${#failures[@]} -gt 0 ]; then
  printf '\n\033[31m✗ failed: %s\033[0m \033[2m— each step'"'"'s output follows in full\033[0m\n' "${failures[*]}" >&2
fi

for name in "${steps[@]}"; do
  printf '\n\033[1m▸ %s\033[0m\n' "$name"
  cat "$logs/$name.log"
done

# Wall-clock, not CPU: the steps run concurrently, so the number that matters is
# how long the human waited. Two decimals — the gate is seconds long, and a change
# that costs 300ms should be visible as one rather than rounding away.
ms=$(( $(now_ms) - started ))
if [ "$ms" -ge 60000 ]; then
  elapsed=$(printf '%dm %d.%02ds' $((ms / 60000)) $((ms / 1000 % 60)) $((ms % 1000 / 10)))
else
  elapsed=$(printf '%d.%02ds' $((ms / 1000)) $((ms % 1000 / 10)))
fi

if [ ${#failures[@]} -gt 0 ]; then
  printf '\n\033[31m✗ failed: %s\033[0m \033[2m(%s)\033[0m\n' "${failures[*]}" "$elapsed" >&2
  exit 1
fi

printf '\n\033[32m✓ all checks passed\033[0m \033[2m(%s)\033[0m\n' "$elapsed"
