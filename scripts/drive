#!/usr/bin/env node
// The harness transport — boot the app headless, feed it commands, stream back events.
// JSONL in, JSONL out. The app tier is the API; this is only the pipe, and it knows
// nothing about decks or effects (plan §5).
//
//   ./scripts/drive fixtures/param-smoke.jsonl    run a command file, stream events
//   echo '{"t":"param.set",...}' | ./scripts/drive
//   ./scripts/drive --repl                        interactive: one command per line
//
// A line is a bare command ({"t":...}) or an envelope ({"at":2,"cmd":{...}});
// {"probe":true} prints the full state as {"probe":...} — also printed once after the
// last command. {"peek":"a"} prints that deck's per-frame read as {"peek":...} — the
// third channel (plan §1), live only: offline nothing peeks (a render's truth is its
// fingerprint), so a render skips the line with a note rather than refusing the file.
// Events go to stdout, one JSON line each; diagnostics go to stderr.
//
// `at` is seconds on the instrument's clock, whose epoch is the page's, not this
// process's — ctx.currentTime, which starts when the page creates its context and stands
// still while that context is suspended. That epoch is unknowable to whoever writes a
// fixture, so two transport-level forms resolve against it here, at send time:
//
//   {"after":0.25,"cmd":{...}}  an envelope scheduled 0.25s from now — an `at` computed
//                               from the page's own clock, so a slow build cannot make a
//                               fixture's schedule arrive already overdue
//   {"wait":1}                  send nothing; block until the instrument's clock has
//                               advanced 1s, so audio that takes time to happen has it
//
// Both are the transport translating a hand-written script into wire envelopes. The
// instrument's own contract stays absolute: it never sees `after` or `wait`. ("after",
// not "in": `deck.loop` already carries an `in`, and two meanings for one key in one
// file is a trap however well the levels separate them.)
//
// With --render the same file becomes a performance rendered offline instead:
//
//   ./scripts/drive --render 2 fixtures/render-smoke.jsonl
//   ./scripts/drive --render 4 --out /tmp/x.wav --png /tmp/x.png fixtures/deck-smoke.jsonl
//
// The clock is then the render timeline rather than the page's, so both relative forms
// resolve against a cursor that starts at 0: `wait` advances it, `after` is measured from
// it, and a bare command is stamped at it. The last line out is {"fingerprint":…} — what
// it sounded like, as text an agent can diff (plan §3). Tolerances live with the fields,
// in src/lib/fingerprint.ts; comparing against a golden is scripts/smoke's job.
//
// The loop stays seconds long (plan §3): a preview server already listening on 4173 is
// reused; otherwise the cached build in dist/ is served, rebuilt only when src/ is newer.
//   --fresh   rebuild unconditionally — for when the build is what you distrust
//   --dev     drive a running dev server instead (start one with ./scripts/dev)
//   --url U   drive an explicit URL, no server management at all
//   --expect-no-attach   boot WITHOUT the drive flag and fail if window.mulch exists —
//                        the negative half of the attach contract, run by scripts/smoke
import { existsSync, readFileSync, readdirSync, statSync, writeFileSync } from "node:fs";
import { dirname, join, resolve } from "node:path";
import { createInterface } from "node:readline";
import { fileURLToPath } from "node:url";

import { chromium } from "playwright";

const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), "..");

const args = process.argv.slice(2);
const flag = (name) => {
  const i = args.indexOf(name);
  if (i === -1) return false;
  args.splice(i, 1);
  return true;
};
const option = (name) => {
  const i = args.indexOf(name);
  if (i === -1) return undefined;
  const [, value] = args.splice(i, 2);
  if (value === undefined) die(`${name} needs a value`);
  return value;
};
const die = (message) => {
  console.error(`drive: ${message}`);
  process.exit(1);
};
const note = (message) => console.error(`drive: ${message}`);

const repl = flag("--repl");
const fresh = flag("--fresh");
const dev = flag("--dev");
const expectNoAttach = flag("--expect-no-attach");
const urlOption = option("--url");
const renderOption = option("--render");
const wavOut = option("--out");
const pngOut = option("--png");
const files = args.filter((a) => !a.startsWith("-"));
const unknown = args.find((a) => a.startsWith("-"));
if (unknown) die(`unknown flag: ${unknown}`);
if (dev && expectNoAttach) die("--expect-no-attach tests the preview build; dev attaches by design");

// Seconds, with the unit optional because both spellings are natural to type: `--render 4`
// and `--render 4s` are the same request, and the plan writes it the second way.
const renderSecs = renderOption === undefined ? undefined : Number(renderOption.replace(/s$/, ""));
if (renderOption !== undefined && !(renderSecs > 0)) {
  die(`--render needs a length in seconds: ${renderOption}`);
}
if (renderSecs !== undefined && repl) die("--render happens once, at EOF — there is no repl in it");
if (renderSecs !== undefined && expectNoAttach) die("--expect-no-attach boots no instrument");
// Said here rather than silently producing nothing: an offline render is the only thing that
// has a whole buffer to write, so these flags without it are a misunderstanding worth naming.
for (const [flagName, value] of [["--out", wavOut], ["--png", pngOut]]) {
  if (value !== undefined && renderSecs === undefined) die(`${flagName} needs --render`);
}

// ---- the page to drive: reuse a server, reuse the build, build only when stale ----

/** Is this URL already serving mulch? Sniff the title so a stranger's server is never driven. */
async function serves(url) {
  try {
    const res = await fetch(url, { signal: AbortSignal.timeout(400) });
    return res.ok && (await res.text()).includes("<title>mulch</title>");
  } catch {
    return false;
  }
}

/** Newest mtime under the paths that shape the build — cheap (~100 stats), run per invocation. */
function newestSource() {
  const newest = (path) => {
    const stat = statSync(path);
    if (!stat.isDirectory()) return stat.mtimeMs;
    return Math.max(
      stat.mtimeMs,
      ...readdirSync(path).map((entry) => newest(join(path, entry))),
    );
  };
  return Math.max(
    ...["src", "index.html", "vite.config.ts", "package.json", "pnpm-lock.yaml"]
      .map((p) => join(ROOT, p))
      .filter((p) => existsSync(p))
      .map(newest),
  );
}

let server;
let url = urlOption;
if (url === undefined && dev) {
  url = "http://localhost:5173/";
  if (!(await serves(url))) die("--dev needs a running dev server — start one with ./scripts/dev");
}
if (url === undefined) {
  // The build decision comes first, independent of the server decision: a running preview
  // server serves dist/ straight off disk, so a rebuild refreshes what it serves too.
  // Reusing a server without this check would let ./scripts/check go green against a
  // bundle that predates the change under test — the exact thing the gate exists to catch.
  const built = join(ROOT, "dist/index.html");
  if (fresh || !existsSync(built) || statSync(built).mtimeMs < newestSource()) {
    note("building (src is newer than dist — skipped when neither changed)…");
    const { build } = await import("vite");
    await build({ root: ROOT, logLevel: "warn" });
  }
  const running = "http://localhost:4173/";
  if (await serves(running)) {
    url = running;
    note(`reusing the preview server at ${running}`);
  } else {
    const vite = await import("vite");
    // vite.preview() adds a stdin "end" listener that closes the server and process.exit()s —
    // meant for its CLI, fatal here: drive reads stdin (a pipe, a file redirect) to EOF, and
    // that exit(0) would race the final probe line. Drive owns both stdin and this server's
    // lifetime, so the listener vite just added comes off. (Its SIGTERM handler can stay.)
    const priorEndListeners = new Set(process.stdin.listeners("end"));
    server = await vite.preview({ root: ROOT, preview: { port: 0 }, logLevel: "warn" });
    for (const listener of process.stdin.listeners("end")) {
      if (!priorEndListeners.has(listener)) process.stdin.off("end", listener);
    }
    url = server.resolvedUrls?.local[0] ?? die("vite preview reported no local URL");
  }
}

// ---- the browser: the same flags the M1 spike proved the clock under ----

const browser = await chromium.launch({
  args: ["--autoplay-policy=no-user-gesture-required"],
});
const page = await browser.newPage();
page.on("pageerror", (error) => note(`page error: ${error.message}`));
page.on("console", (message) => {
  if (message.type() === "error") note(`page console.error: ${message.text()}`);
});

async function shutdown(code) {
  await browser.close();
  await server?.close().catch(() => {});
  // process.exit truncates stdout still queued on a pipe — the final probe line, usually.
  // An empty write's callback fires only after everything queued before it has flushed.
  await new Promise((flushed) => process.stdout.write("", flushed));
  process.exit(code);
}

if (expectNoAttach) {
  // No init script on purpose: this run asserts the flag-less page keeps the hook inert.
  await page.goto(url, { waitUntil: "load" });
  // A dead page has no window.mulch either. Prove the app booted — React rendered into
  // #root — before asserting what it did not attach, or a broken build passes vacuously.
  await page.waitForFunction(
    () => (document.getElementById("root")?.childElementCount ?? 0) > 0,
    undefined,
    { timeout: 15_000 },
  );
  const attached = await page.evaluate(() => "mulch" in window);
  if (attached) {
    console.error("✗ window.mulch is attached on a page with no __MULCH_DRIVE__ flag");
    await shutdown(1);
  }
  console.log("✓ flag-less page has no window.mulch");
  await shutdown(0);
}

// Events cross the wire one binding call per event, forwarded as emitted and queued on
// this side — a slow consumer here can never cause a seq gap (plan §1). `emitted` vs
// `received` is how the final probe waits for the stream to be fully flushed first.
let received = 0;
await page.exposeFunction("__mulchEmit", (event) => {
  received += 1;
  process.stdout.write(`${JSON.stringify(event)}\n`);
});
await page.addInitScript(() => {
  window.__MULCH_DRIVE__ = true;
});
await page.goto(url, { waitUntil: "load" });
await page.waitForFunction(() => "mulch" in window, undefined, { timeout: 15_000 });
// A render is its own session on its own context (src/app/render.ts), and returns its own
// events in one go — subscribing to the live instrument as well would interleave a second
// stream, with a second seq, into the one an agent is reading.
if (renderSecs === undefined) {
  await page.evaluate(() => {
    window.__mulchEmitted = 0;
    window.mulch.on((event) => {
      window.__mulchEmitted += 1;
      window.__mulchEmit(event);
    });
  });
}

/** Wait until every scheduled envelope has run and every event it caused has landed here. */
async function settle(maxAt) {
  if (maxAt !== undefined && maxAt > -Infinity) {
    // The clock passing `at` is necessary but not sufficient — the envelope still has to
    // be delivered, and the page's own pump runs on an interval. pump() drains everything
    // due synchronously, so the predicate both waits and delivers; pumping twice is a no-op.
    await page.waitForFunction(
      (t) => {
        if (window.mulch.probe().at < t) return false;
        window.mulch.pump();
        return true;
      },
      maxAt,
      { timeout: 60_000 },
    );
  }
  const deadline = Date.now() + 5_000;
  for (;;) {
    const emitted = await page.evaluate(() => window.__mulchEmitted);
    if (received >= emitted) return;
    if (Date.now() > deadline) die(`event stream never settled: ${received}/${emitted} received`);
    await new Promise((r) => setTimeout(r, 10));
  }
}

async function printProbe(maxAt) {
  await settle(maxAt);
  const state = await page.evaluate(() => window.mulch.probe());
  process.stdout.write(`${JSON.stringify({ probe: state })}\n`);
}

// The deck id passes through opaque, exactly as probe's whole state does — the app tier
// answers for it (a bad id is its loud throw), and this stays a pipe that knows no decks.
async function printPeek(deck, maxAt) {
  await settle(maxAt);
  const read = await page.evaluate((d) => ({ deck: d, ...window.mulch.peek(d) }), deck);
  process.stdout.write(`${JSON.stringify({ peek: read })}\n`);
}

// ---- the input: files first, then stdin when piped or --repl ----

async function* inputLines() {
  for (const file of files) {
    if (!existsSync(join(ROOT, file)) && !existsSync(file)) die(`no such file: ${file}`);
    const path = existsSync(file) ? file : join(ROOT, file);
    yield* readFileSync(path, "utf8").split("\n");
  }
  if (repl || !process.stdin.isTTY) {
    yield* createInterface({ input: process.stdin });
  }
}

/**
 * What one input line is. Four shapes: the two the instrument takes as they are (`now`, `at`)
 * and the two the transport resolves against whichever clock this mode runs on (`after`,
 * `wait`), plus `probe`. Both modes read the same shapes; only the clock they resolve against
 * differs, which is the whole difference between driving and rendering.
 */
function classify(line) {
  if (line === null || typeof line !== "object") return { kind: "now", cmd: line };
  if (line.probe === true) return { kind: "probe" };
  if (typeof line.peek === "string") return { kind: "peek", deck: line.peek };
  if (typeof line.wait === "number") return { kind: "wait", secs: line.wait };
  if (typeof line.after === "number") {
    // Both spellings, because both are natural to write by hand: an envelope with a `cmd`,
    // or a bare command wearing an `after`. The second is the first with the key removed.
    const { after, cmd, ...rest } = line;
    return { kind: "after", secs: after, cmd: cmd ?? rest };
  }
  if (typeof line.at === "number") return { kind: "at", at: line.at, cmd: line.cmd };
  return { kind: "now", cmd: "cmd" in line ? line.cmd : line };
}

async function* inputEntries() {
  for await (const raw of inputLines()) {
    const line = raw.trim();
    if (line === "" || line.startsWith("#")) continue;
    try {
      yield classify(JSON.parse(line));
    } catch (error) {
      if (error instanceof SyntaxError) {
        if (!repl) die(`not JSON: ${line}`);
        note(`not JSON: ${line}`);
        continue;
      }
      throw error;
    }
  }
}

if (renderSecs !== undefined) {
  // Offline the clock is the render timeline, and nothing has happened yet, so "now" is a
  // cursor this loop keeps rather than a question for the page. That makes a fixture written
  // for the live host mean the same thing here: `wait 1` then a command is a command at 1s.
  let cursor = 0;
  const envelopes = [];
  const probes = [];
  for await (const entry of inputEntries()) {
    // A peek is a live read; offline nothing peeks and a render's truth is its fingerprint.
    // Skipped, not refused, so one fixture stays drivable and renderable alike (§3).
    if (entry.kind === "peek") note(`peek skipped offline: ${entry.deck}`);
    else if (entry.kind === "probe") probes.push(cursor);
    else if (entry.kind === "wait") cursor += entry.secs;
    else if (entry.kind === "after") envelopes.push({ at: cursor + entry.secs, cmd: entry.cmd });
    else if (entry.kind === "at") envelopes.push({ at: entry.at, cmd: entry.cmd });
    else envelopes.push({ at: cursor, cmd: entry.cmd });
  }

  let result;
  try {
    result = await page.evaluate(
      (spec) => window.mulch.render(spec),
      { secs: renderSecs, envelopes, probes, wav: wavOut !== undefined, png: pngOut !== undefined },
    );
  } catch (error) {
    console.error(`drive: render failed: ${error.message}`);
    await shutdown(1);
  }

  // The same stream shape as a live run — events in seq order with each probe where it was
  // taken — then the one line only a render can print. A render returns everything at once,
  // so the interleaving that a live run gets for free has to be reconstructed from `after`.
  const emit = (line) => process.stdout.write(`${JSON.stringify(line)}\n`);
  let taken = 0;
  const takeProbesUpTo = (index) => {
    while (taken < result.probes.length && result.probes[taken].after <= index) {
      emit({ probe: result.probes[taken++].probe });
    }
  };
  for (const [index, event] of result.events.entries()) {
    takeProbesUpTo(index);
    emit(event);
  }
  takeProbesUpTo(result.events.length);
  emit({ fingerprint: result.fingerprint });
  if (wavOut !== undefined) {
    writeFileSync(wavOut, Buffer.from(result.wav, "base64"));
    note(`wrote ${wavOut}`);
  }
  if (pngOut !== undefined) {
    writeFileSync(pngOut, Buffer.from(result.png, "base64"));
    note(`wrote ${pngOut}`);
  }
  await shutdown(0);
}

let maxAt = -Infinity;
for await (const entry of inputEntries()) {
  if (entry.kind === "probe") {
    await printProbe(maxAt);
    continue;
  }
  if (entry.kind === "peek") {
    await printPeek(entry.deck, maxAt);
    continue;
  }
  // Both relative forms need the page's clock, so they cost one round trip each. Neither
  // is a command: `wait` sends nothing, and `after` becomes an ordinary `at` before it goes.
  const now = async () => page.evaluate(() => window.mulch.probe().at);
  if (entry.kind === "wait") {
    maxAt = Math.max(maxAt, (await now()) + entry.secs);
    await settle(maxAt);
    continue;
  }
  const envelope =
    entry.kind === "after"
      ? { at: (await now()) + entry.secs, cmd: entry.cmd }
      : entry.kind === "at"
        ? { at: entry.at, cmd: entry.cmd }
        : entry.cmd;
  if (typeof envelope?.at === "number") maxAt = Math.max(maxAt, envelope.at);
  try {
    await page.evaluate((input) => window.mulch.send(input), envelope);
  } catch (error) {
    // send() throwing is the facade refusing malformed input — loud by design.
    if (repl) {
      note(error.message);
      continue;
    }
    console.error(`drive: send failed: ${error.message}`);
    await shutdown(1);
  }
}

await printProbe(maxAt);
await shutdown(0);
