#!/usr/bin/env node
// Enforce what docs/map.md claims about src/: the dependency direction between tiers, the one
// production owner each signal-chain constructor has, and the hard line cap. An unenforced rule
// is one that has already been broken somewhere nobody has looked.
//
// The tiers table and the caps are read out of docs/map.md rather than restated here. This file
// used to hold its own copy of the table under a comment asking the next person to keep the two
// in step, which is principle 1 broken by the script that exists to enforce it (0044). Longest
// prefix wins, so `src/ui/components` is matched before `src/ui`. Files directly in `src/` (the
// entry point) belong to no tier and may import anything.
import { readdirSync, readFileSync } from "node:fs";
import { dirname, join, relative, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), "..");
const SRC = join(ROOT, "src");

const fail = (message) => {
  console.error(message);
  process.exit(1);
};

const map = readFileSync(join(ROOT, "docs/map.md"), "utf8");

// Read a doc that has been reworded rather than a doc that has been changed, and this script
// silently checks nothing at all — so every parse below fails loudly instead of returning empty.
const section = (heading) => {
  const start = map.indexOf(`\n## ${heading}\n`);
  if (start === -1) fail(`docs/map.md: no "## ${heading}" section — scripts/arch reads its rules from it.`);
  const rest = map.slice(start + 1);
  const end = rest.indexOf("\n## ");
  return end === -1 ? rest : rest.slice(0, end);
};

/**
 * The Tiers table, as the rule itself rather than as prose beside the rule. Each row reads
 * `| **name** | `path` | what belongs here | may import from |`, and that last column names
 * other rows by their short name — or says in words that a tier may import nothing.
 */
const parseTiers = () => {
  const ROW = /^\|\s*\*\*([\w/]+)\*\*\s*\|\s*`([^`]+)`\s*\|[^|]*\|\s*([^|]*?)\s*\|/gmu;
  const rows = [...section("Tiers").matchAll(ROW)];
  if (rows.length === 0) fail("docs/map.md: the Tiers table parsed as no rows — this check is not looking where it should.");
  const pathOf = new Map(rows.map(([, name, path]) => [name, path]));
  const mayImport = {};
  for (const [, name, path, imports] of rows) {
    mayImport[path] = imports === "nothing in this table"
      ? []
      : imports.split(",").map((named) => {
        const target = pathOf.get(named.trim());
        if (!target) fail(`docs/map.md: tier "${name}" may import "${named.trim()}", which is not a row in that table.`);
        return target;
      });
  }
  return mayImport;
};

/**
 * The caps, from the sentence that states them. The soft cap is the linter's to report — it is a
 * judgment call, waived in the file with a reason (0007). The hard cap is not a judgment call,
 * which is why it is checked here, where a source-level `oxlint-disable` comment cannot reach it.
 */
const parseCaps = () => {
  const found = /\*\*Soft cap (\d+) lines per file, hard cap (\d+)\.\*\*/u.exec(section("Naming"));
  if (!found) fail("docs/map.md: the line-cap sentence is missing or reworded — scripts/arch reads both caps from it.");
  return { soft: Number(found[1]), hard: Number(found[2]) };
};

const MAY_IMPORT = parseTiers();
const CAPS = parseCaps();

const TIERS = Object.keys(MAY_IMPORT).sort((a, b) => b.length - a.length);
const tierOf = (path) => TIERS.find((t) => path === t || path.startsWith(`${t}/`));

const walk = (dir) =>
  readdirSync(dir, { withFileTypes: true }).flatMap((e) => {
    const full = join(dir, e.name);
    if (e.isDirectory()) return walk(full);
    return /\.(?:tsx?|css)$/.test(e.name) ? [full] : [];
  });

// Static `from "…"`, bare `import "…"`, and dynamic `import("…")`.
const SPECIFIER = /(?:\bfrom\s*|\bimport\s*\(?\s*)["']([^"']+)["']/g;

/**
 * The colour boundary, enforced rather than remembered: no colour literal outside
 * `src/ui/tokens.css`, in CSS or in a Tailwind arbitrary value (docs/boundaries.md). The two
 * reviewed exceptions are the favicon (0006), which is not under `src/` and so is not reached
 * here, and the offline render's diagnostic PNG (0015), which is.
 *
 * Added by P175, whose two `src/ui` territory lenses swept all 186 files for exactly this by hand
 * and found it clean. An invariant that holds only because two agents checked it once is an
 * invariant with a re-entry date; the whole of what makes this one durable is that the gate now
 * refuses the next one (0044).
 */
const COLOUR = /#[0-9a-fA-F]{3,8}\b|\b(?:rgba?|hsla?|oklch|oklab|lch|lab)\(/u;
/** The one place under `src/` a colour is written, and the one file reviewed out of the rule. */
const COLOUR_HOME = "src/ui/tokens.css";
const COLOUR_WAIVED = "src/app/render.ts";
/**
 * In TypeScript a colour can only be a string — a `className`, a canvas fill, a style value — so
 * comments are cut out first and only strings are read after. A paragraph explaining which ink a
 * token resolves to names a colour on purpose and is not a violation; a `color-mix()` of two
 * tokens is a derivation from them and carries no literal of its own.
 */
const COMMENT = /\/\*[\s\S]*?\*\/|\/\/[^\n]*/gu;
const STRING = /"[^"\n]*"|'[^'\n]*'|`[^`]*`/gu;

const violations = [];
/** Both named files were walked, so a rename cannot switch this rule off in silence. */
const colourSites = new Set();

// The soft cap is stated in two places because two different tools need it. They agree here, or
// the doc and the linter are describing different codebases. Read by pattern rather than parsed:
// .oxlintrc.json carries comments, so it is JSONC and JSON.parse chokes on it.
const lintrc = readFileSync(join(ROOT, ".oxlintrc.json"), "utf8");
const configured = /"max-lines"\s*:\s*\[[^\]]*"max"\s*:\s*(\d+)/u.exec(lintrc);
if (!configured) {
  violations.push('  .oxlintrc.json has no "max-lines" rule  (docs/map.md states a soft cap, so something must report it)');
} else if (Number(configured[1]) !== CAPS.soft) {
  violations.push(
    `  .oxlintrc.json runs max-lines at ${configured[1]}  (docs/map.md states a soft cap of ${CAPS.soft})`,
  );
}

// Signal-chain constructors have one production caller apiece. The tier table alone permits any
// app file to import any audio file, which would let an export-only graph grow beside the live
// one without crossing a tier. Tests may instantiate a seam directly; production may not.
const GRAPH_CALLERS = {
  createMasterBus: ["src/audio/context.ts", "src/app/engine.ts"],
  createDeckVoice: ["src/audio/deck.ts", "src/app/engine.ts"],
  buildDeckChain: ["src/audio/chain.ts", "src/audio/deck.ts"],
  // The automator is the one entry that holds a rack of its own — the same chain, one level in,
  // on the same context and disposed by the instance holding it. Not a second graph beside the
  // live one, which is what this rule exists to refuse (0203).
  createEffectRack: [
    "src/audio/effects/rack.ts",
    "src/audio/chain.ts",
    "src/audio/effects/automator.ts",
  ],
};
for (const file of walk(SRC)) {
  const rel = relative(ROOT, file);
  const source = readFileSync(file, "utf8");

  // The colour boundary, over every file under src/ — a stylesheet is read whole, since every line
  // of one is a value, and TypeScript only through its strings.
  if (rel === COLOUR_HOME || rel === COLOUR_WAIVED) {
    colourSites.add(rel);
  } else {
    const written = rel.endsWith(".css")
      ? [source]
      : [...source.replaceAll(COMMENT, " ").matchAll(STRING)].map(([text]) => text);
    for (const text of written) {
      const found = COLOUR.exec(text);
      if (found) {
        violations.push(
          `  ${rel} writes the colour ${found[0]}  (no colour literal outside ${COLOUR_HOME} — docs/boundaries.md)`,
        );
        break;
      }
    }
  }
  if (rel.endsWith(".css")) continue;

  // Every file under src/, tier or no tier: the entry point is not exempt from being readable.
  const lines = source.split("\n").length - (source.endsWith("\n") ? 1 : 0);
  if (lines > CAPS.hard) {
    violations.push(`  ${rel} is ${lines} lines  (hard cap ${CAPS.hard} — split it, no waiver applies)`);
  }

  const from = tierOf(rel);
  if (!from) continue;
  const allowed = MAY_IMPORT[from];
  for (const [, spec] of source.matchAll(SPECIFIER)) {
    let target;
    if (spec.startsWith("@/")) target = join("src", spec.slice(2));
    else if (spec.startsWith(".")) target = relative(ROOT, resolve(dirname(file), spec));
    else continue; // a package, not one of ours
    const to = tierOf(target);
    if (!to || to === from || allowed.includes(to)) continue;
    violations.push(`  ${rel} → ${spec}  (${from} may not import ${to})`);
  }
  if (!rel.endsWith(".test.ts") && !rel.endsWith(".test.tsx")) {
    for (const [builder, callers] of Object.entries(GRAPH_CALLERS)) {
      if (!callers.includes(rel) && new RegExp(`\\b${builder}\\s*\\(`).test(source)) {
        violations.push(`  ${rel} calls ${builder}  (the shared signal chain has one owner)`);
      }
    }
  }
}

// A rule whose two named files have been renamed out from under it checks nothing at all, and it
// would do so silently — the same failure the doc parses above are written to fail loudly on.
for (const named of [COLOUR_HOME, COLOUR_WAIVED]) {
  if (!colourSites.has(named)) {
    fail(`${named} is gone — scripts/arch reads the colour boundary against it (docs/boundaries.md).`);
  }
}

if (violations.length > 0) {
  fail(`docs/map.md says otherwise:\n${violations.join("\n")}`);
}
console.log(
  `dependency direction, shared signal-chain ownership and the ${CAPS.hard}-line hard cap hold across ${TIERS.length} tiers`,
);
