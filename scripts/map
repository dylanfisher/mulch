#!/usr/bin/env node
// The catalogue — what each file in src/ is, on one screen.
//
// docs/map.md deliberately holds no inventory: a hand-written list of what exists
// is a second copy of facts the code already has, and nothing fails when it rots.
// So the list lives where it cannot drift — one `@role` line at the top of each
// file — and this script is the grep that assembles it.
//
//   ./scripts/map            print the catalogue
//   ./scripts/map src/audio  print one tier of it
//   ./scripts/map --check    fail if a file has no @role, or names a path that is gone
//
// The second form runs as the `roles` step of ./scripts/check, which is what makes
// this different from a doc: a new file without a @role does not reach main.
import { existsSync, readdirSync, readFileSync } from "node:fs";
import { dirname, join, relative, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), "..");

// The tiers come from docs/map.md's own paths line — the same one ./scripts/check
// verifies exists — so a renamed tier is written down once, not three times.
const MAP = readFileSync(join(ROOT, "docs/map.md"), "utf8");
const pathsLine = /^<!-- paths: (.+) -->$/m.exec(MAP);
if (!pathsLine) {
  console.error("docs/map.md is missing its <!-- paths: ... --> line — that line is the tier list.");
  process.exit(1);
}
// Two orders, one list: printed in the order map.md declares, matched longest-prefix
// first so `src/ui/components` wins over `src/ui` for a file inside it.
const TIER_ORDER = pathsLine[1].trim().split(/\s+/);
const TIERS = [...TIER_ORDER].sort((a, b) => b.length - a.length);

// src/ui/components is regenerated by `pnpm dlx shadcn@latest add <name>` (docs/map.md),
// so a @role written into one is lost on the next run. Those files are indexed by their
// exports instead, and the gallery at #/dev is the version you look at.
const GENERATED = "src/ui/components";

const tierOf = (path) => TIERS.find((t) => path === t || path.startsWith(`${t}/`));

const walk = (dir) =>
  readdirSync(dir, { withFileTypes: true }).flatMap((e) => {
    const full = join(dir, e.name);
    if (e.isDirectory()) return walk(full);
    return /\.tsx?$/.test(e.name) && !/\.test\.tsx?$/.test(e.name) ? [full] : [];
  });

/** A comment line with its leader and trailer stripped, or null if it is not one:
 *  `/** @role Foo. *​/` and ` * @role Foo.` both yield `@role Foo.` */
const uncomment = (line) => {
  if (/^\s*\*\/\s*$/.test(line)) return ""; // a block's closing line — inside it, but empty
  if (!/^\s*(?:\/\/|\/?\*)/.test(line)) return null;
  return /^\s*(?:\/\/|\/?\*+)\s*(.*?)\s*(?:\*\/)?\s*$/.exec(line)[1];
};

/**
 * The text of each `@<name>` tag. A tag runs until the next tag or the end of its
 * comment — wrapping a long @instead onto a second line must not silently drop half
 * of it from the catalogue, or half of its paths from the check.
 */
const tag = (source, name) => {
  const found = [];
  let open = null;
  for (const line of source.split("\n")) {
    const text = uncomment(line);
    if (text === null) {
      open = null;
      continue;
    }
    const start = new RegExp(`^@${name}\\s+(.+)$`).exec(text);
    if (start) {
      open = found.push(start[1]) - 1;
    } else if (open !== null) {
      if (text === "" || text.startsWith("@")) open = null;
      else found[open] += ` ${text}`;
    }
  }
  return found;
};

/** Exported names, for the generated tier: `export { Button, buttonVariants }`. */
const exportsOf = (source) =>
  [...source.matchAll(/^export \{([^}]*)\}|^export (?:function|const|type) (\w+)/gm)]
    .flatMap((m) => (m[1] ?? m[2]).split(","))
    .map((n) => n.trim().replace(/^type /, ""))
    .filter(Boolean);

// Nested tiers walk each other's files, so the path is the key — `src/ui/components`
// is reached from both itself and `src/ui`, and belongs to the longer of the two.
const found = new Map();
for (const tier of TIERS) {
  // A tier that moved is the paths line rotting, and the failure the gate exists to name —
  // an ENOENT stack out of readdirSync says nothing about where to fix it.
  if (!existsSync(join(ROOT, tier))) {
    console.error(`docs/map.md lists the tier ${tier}, which does not exist — fix its paths line.`);
    process.exit(1);
  }
  for (const full of walk(join(ROOT, tier))) found.set(relative(ROOT, full), full);
}

const files = [...found]
  .map(([path, full]) => {
    const source = readFileSync(full, "utf8");
    return {
      path,
      tier: tierOf(path),
      roles: tag(source, "role"),
      instead: tag(source, "instead"),
      exports: exportsOf(source),
    };
  })
  .sort(
    (a, b) =>
      TIER_ORDER.indexOf(a.tier) - TIER_ORDER.indexOf(b.tier) || a.path.localeCompare(b.path),
  );

if (process.argv.includes("--check")) {
  const problems = [];
  for (const file of files) {
    const generated = file.tier === GENERATED;
    if (!generated && file.roles.length === 0) {
      problems.push(`  ${file.path} has no @role — one line saying what it is, at the top.`);
    }
    if (file.roles.length > 1) {
      problems.push(`  ${file.path} has ${file.roles.length} @role lines — a file is one thing.`);
    }
    // A pointer to a file that moved is worse than no pointer: it reads as authoritative.
    // Checked against the filesystem, not `files`: docs/map.md's own examples point at a
    // directory (`src/audio/effects/`) and at CSS, neither of which `walk` collects.
    for (const line of [...file.roles, ...file.instead]) {
      for (const [, named] of line.matchAll(/\b(src\/[\w./-]*[\w/])/g)) {
        if (!existsSync(join(ROOT, named.replace(/\/$/, "")))) {
          problems.push(`  ${file.path} points at ${named}, which does not exist.`);
        }
      }
    }
  }
  if (problems.length > 0) {
    console.error(`@role lines — see the Roles section of docs/map.md:\n${problems.join("\n")}`);
    process.exit(1);
  }
  const described = files.filter((f) => f.tier !== GENERATED).length;
  console.log(`${described} files describe themselves, every pointer resolves`);
  process.exit(0);
}

// A bare path argument narrows the listing — one tier is a cheaper read than all of them.
const only = process.argv.slice(2).filter((a) => !a.startsWith("-"));
const shown = only.length === 0
  ? files
  : files.filter((f) => only.some((p) => f.path === p || f.path.startsWith(`${p.replace(/\/$/, "")}/`)));

if (shown.length === 0) {
  console.error(`nothing under ${only.join(" ")} — the tiers are: ${TIER_ORDER.join(" ")}`);
  process.exit(1);
}

const width = Math.max(...shown.map((f) => f.path.length)) + 2;
let tier = null;
const out = [];
for (const file of shown) {
  if (file.tier !== tier) {
    tier = file.tier;
    out.push(`\n${tier}${tier === GENERATED ? "  (generated — see #/dev)" : ""}`);
  }
  const summary = file.roles[0] ?? file.exports.join(", ");
  out.push(`  ${file.path.padEnd(width)}${summary}`);
  for (const line of file.instead) out.push(`  ${"".padEnd(width)}↳ instead: ${line}`);
}
console.log(`${out.join("\n").trim()}\n`);
