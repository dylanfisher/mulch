#!/usr/bin/env node
// The drive step of ./scripts/check — the smoke from plan §3, against the real preview build
// in the real headless Chromium. Three halves: the no-audio one (param.set in, param.changed
// out, a gapless seq, a probe() that agrees, and the attach contract's negative half), the M2
// one (a generated source loads, starts, loops, and grows an effect rack), and the M3/M5 one
// (an offline render whose filter and delay fingerprint still matches a golden). The assertions live
// here so ./scripts/drive stays a transport that knows nothing about decks or params.
//
//   ./scripts/smoke --bless   rewrite the golden fingerprint from this run, for when the
//                             difference is a change you meant. Never run it to make the gate
//                             green: a golden nobody read is a golden that asserts nothing.
//
// The runs are independent, so they go at once. This step is the whole critical path of
// ./scripts/check — everything else finishes underneath it — and the deck fixture spends most
// of its time waiting on real audio time that no amount of CPU shortens. Serially the other
// runs were pure addition; alongside, they are free.
import { spawn, spawnSync } from "node:child_process";
import {
  existsSync,
  mkdtempSync,
  readFileSync,
  rmSync,
  writeFileSync,
} from "node:fs";
import { tmpdir } from "node:os";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";

import { chromium } from "playwright";

// The one implementation of the tolerances, imported rather than restated: the page computes a
// fingerprint with it and this compares one with it (Node strips the types on the way in).
import { compareFingerprints } from "../src/lib/fingerprint.ts";
import { SESSION_ARCHIVE_FILE } from "../src/lib/sessionArchive.ts";
// The transport's own lookahead, imported for the same reason: the render's start time is
// asserted against the number the transport schedules with, not a restated 0.05.
import { LOOKAHEAD_SECS } from "../src/audio/transport.ts";
import { CURRENT_SESSION_VERSION } from "../src/state/version.ts";
import {
  encodeWav,
  WAV_BITS,
  WAV_BYTES_PER_SAMPLE,
  WAV_HEADER_BYTES,
  WAV_QUANTIZATION_EPSILON,
} from "../src/lib/wav.ts";

const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), "..");
const bless = process.argv.includes("--bless");
/** How long the render fixture is. Its commands occupy 1.3s; the rest exposes the delay tail. */
const RENDER_SECS = 2;
const PARITY_RENDER_SECS = 0.25;
/** Four fingerprint windows: two under the filter, two after the scheduled bypass at 0.2s. */
const RACK_RENDER_SECS = 0.4;
/** How much louder an unfiltered 733Hz sine has to be than the same sine through a 200Hz lowpass. */
const RACK_BYPASS_DB = 10;
/** Six fingerprint windows: the EQ's peak away from the tone, swept onto it, then cutting it. */
const EQ_RENDER_SECS = 0.6;
/** How much of the EQ's 18dB the render has to actually deliver, boosting and cutting alike. */
const EQ_BAND_DB = 12;
const GOLDEN = join(ROOT, "fixtures/golden/render-smoke.json");
const exportDir = mkdtempSync(join(tmpdir(), "mulch-export-smoke-"));
const exportPath = join(exportDir, "loop-clear.wav");
process.on("exit", () => rmSync(exportDir, { force: true, recursive: true }));

const fail = (message) => {
  console.error(`smoke: ${message}`);
  process.exit(1);
};

// Say "run ./scripts/setup" here, before drive buries playwright's raw "Executable
// doesn't exist" in a buffered log — scripts/check's own guard only probes node_modules.
if (!existsSync(chromium.executablePath())) {
  fail("headless Chromium is not installed — run ./scripts/setup");
}

const drive = (...args) =>
  new Promise((done) => {
    // stdin ignored, not piped: drive reads stdin to EOF whenever it is not a TTY, and an
    // open pipe nobody writes to never reaches one — the run hangs instead of finishing.
    const child = spawn(join(ROOT, "scripts/drive"), args, {
      cwd: ROOT,
      stdio: ["ignore", "pipe", "pipe"],
    });
    let stdout = "";
    let stderr = "";
    child.stdout.setEncoding("utf8").on("data", (d) => (stdout += d));
    child.stderr.setEncoding("utf8").on("data", (d) => (stderr += d));
    child.on("close", (status) => done({ status, stdout, stderr }));
  });

/**
 * M6's storage path in one browser profile: unchanged bytes into IndexedDB, ordinary blob-id
 * command into the real graph, atomic save/GC, then a same-origin reload and automatic restore.
 */
const persistenceSmoke = async () => {
  const vite = await import("vite");
  const priorEndListeners = new Set(process.stdin.listeners("end"));
  const server = await vite.preview({ root: ROOT, preview: { port: 0 }, logLevel: "warn" });
  for (const listener of process.stdin.listeners("end")) {
    if (!priorEndListeners.has(listener)) process.stdin.off("end", listener);
  }
  const url = server.resolvedUrls?.local[0] ?? fail("persistence smoke: preview has no URL");
  const browser = await chromium.launch({ args: ["--autoplay-policy=no-user-gesture-required"] });
  const page = await browser.newPage();
  await page.addInitScript(() => {
    window.__MULCH_DRIVE__ = true;
  });

  // A small generated mono WAV — real file bytes, no fixture and no codec dependency.
  const samples = Float32Array.from({ length: 4_800 }, (_, index) =>
    Math.sin((index * Math.PI * 2 * 440) / 48_000) * 0.25,
  );
  const wav = [...encodeWav([samples], 48_000)];

  try {
    await page.goto(url, { waitUntil: "load" });
    await page.waitForFunction(() => "mulch" in window, undefined, { timeout: 15_000 });
    await page.locator('input[aria-label="Import audio for deck a"]').setInputFiles({
      name: "generated.wav",
      mimeType: "audio/wav",
      buffer: Buffer.from(wav),
    });
    await page.waitForFunction(
      () => {
        const deck = window.mulch.probe().decks.a;
        return deck.source !== null && "blobId" in deck.source && deck.duration > 0;
      },
      undefined,
      { timeout: 5_000 },
    );
    const kept = await page.evaluate(() => window.mulch.probe().decks.a.source.blobId);

    // M8's keyboard route in the existing persistence page: focused controls retain Space/L,
    // selection itself is a command, and an unfocused Space reaches the active deck.
    await page.getByRole("button", { name: "Select deck b" }).focus();
    await page.keyboard.press("Space");
    await page.waitForFunction(() => window.mulch.probe().activeDeck === "b");
    const beforeEditable = await page.evaluate(() => window.mulch.ring().at(-1)?.seq ?? -1);
    await page.locator('input[aria-label="Import audio for deck a"]').focus();
    await page.keyboard.press("KeyL");
    const editableEvents = await page.evaluate((after) =>
      window.mulch.ring().filter((event) => event.seq > after),
    beforeEditable);
    await page.getByRole("button", { name: "Select deck a" }).click();
    await page.evaluate(() => {
      if (document.activeElement instanceof HTMLElement) document.activeElement.blur();
    });
    await page.keyboard.press("Space");
    await page.waitForFunction(() =>
      window.mulch.ring().some((event) => event.t === "deck.started" && event.deck === "a"),
    );
    await page.keyboard.press("Space");
    await page.waitForFunction(() =>
      window.mulch
        .ring()
        .some(
          (event) =>
            event.t === "deck.stopped" && event.deck === "a" && event.reason === "command",
        ),
    );
    await page.evaluate(() => {
      window.mulch.send({ t: "param.set", deck: "a", param: "deck.gain", value: 0.33 });
    });
    const beforeEditableUndo = await page.evaluate(
      () => window.mulch.ring().at(-1)?.seq ?? -1,
    );
    await page.locator('input[aria-label="Import audio for deck a"]').focus();
    await page.keyboard.press("Control+Z");
    const editableUndoIgnored = await page.evaluate(
      (after) =>
        window.mulch.probe().decks.a.params["deck.gain"] === 0.33 &&
        !window.mulch
          .ring()
          .some((event) => event.seq > after && event.t === "history.undone"),
      beforeEditableUndo,
    );
    await page.getByRole("button", { name: "undo" }).click();
    await page.waitForFunction(() => window.mulch.probe().decks.a.params["deck.gain"] === 1);
    const redoEnabledAfterUndo = await page.getByRole("button", { name: "redo" }).isEnabled();
    await page.getByRole("button", { name: "redo" }).click();
    await page.waitForFunction(() => window.mulch.probe().decks.a.params["deck.gain"] === 0.33);
    const redoDisabledAfterRedo = await page.getByRole("button", { name: "redo" }).isDisabled();
    await page.evaluate(() => {
      if (document.activeElement instanceof HTMLElement) document.activeElement.blur();
    });
    await page.keyboard.press("Control+Z");
    await page.waitForFunction(() => window.mulch.probe().decks.a.params["deck.gain"] === 1);
    await page.keyboard.press("Control+Shift+Z");
    await page.waitForFunction(() => window.mulch.probe().decks.a.params["deck.gain"] === 0.33);
    const beforeDevRoute = await page.evaluate(() => window.mulch.ring().at(-1)?.seq ?? -1);
    await page.evaluate(() => {
      window.location.hash = "#/dev";
    });
    await page.locator("#type").waitFor();
    await page.keyboard.press("Space");
    const devRouteEvents = await page.evaluate((after) =>
      window.mulch.ring().filter((event) => event.seq > after),
    beforeDevRoute);
    await page.evaluate(() => {
      window.location.hash = "";
    });
    await page.getByRole("button", { name: "Select deck b" }).waitFor();
    await page.evaluate(() => {
      if (document.activeElement instanceof HTMLElement) document.activeElement.blur();
    });
    const globalAfter = await page.evaluate(() => {
      window.mulch.send({ t: "deck.load", deck: "b", source: { gen: "sine", secs: 0.25 } });
      return window.mulch.ring().at(-1).seq;
    });
    await page.keyboard.press("Shift+Space");
    await page.waitForFunction(
      (after) =>
        new Set(
          window.mulch
            .ring()
            .filter((event) => event.seq > after && event.t === "deck.started")
            .map((event) => event.deck),
        ).size === 2,
      globalAfter,
    );
    const globalStarts = await page.evaluate((after) =>
      window.mulch
        .ring()
        .filter((event) => event.seq > after && event.t === "deck.started")
        .map((event) => event.at),
    globalAfter);
    await page.keyboard.press("Shift+Space");
    await page.waitForFunction(
      (after) =>
        new Set(
          window.mulch
            .ring()
            .filter(
              (event) =>
                event.seq > after && event.t === "deck.stopped" && event.reason === "command",
            )
            .map((event) => event.deck),
        ).size === 2,
      globalAfter,
    );
    const keyboard = await page.evaluate(
      ({
        devRouteEvents,
        editableEvents,
        editableUndoIgnored,
        globalStarts,
        redoDisabledAfterRedo,
        redoEnabledAfterUndo,
      }) => ({
        editableIgnored: !editableEvents.some(
          (event) => event.t === "deck.loop.changed" || event.t === "error",
        ),
        editableUndoIgnored,
        devRouteIgnored: !devRouteEvents.some(
          (event) => ["deck.started", "deck.stopped", "error"].includes(event.t),
        ),
        activeDeck: window.mulch.probe().activeDeck,
        activatedBoth: ["a", "b"].every((deck) =>
          window.mulch.ring().some((event) => event.t === "deck.activated" && event.deck === deck),
        ),
        globalAligned:
          globalStarts.length === 2 && globalStarts.every((at) => at === globalStarts[0]),
        historyCommands:
          window.mulch.ring().filter((event) => event.t === "history.undone").length >= 2 &&
          window.mulch.ring().filter((event) => event.t === "history.redone").length >= 2,
        historyButtons: redoEnabledAfterUndo && redoDisabledAfterRedo,
        errors: window.mulch
          .ring()
          .filter((event) => event.t === "error")
          .map((event) => event.detail),
      }),
      {
        devRouteEvents,
        editableEvents,
        editableUndoIgnored,
        globalStarts,
        redoDisabledAfterRedo,
        redoEnabledAfterUndo,
      },
    );

    // P3/P5 ride the same browser: each deliberate point edit commits one durable lane
    // replacement, and the ordinary history commands undo and redo that whole gesture (0024).
    const lane = page.locator('svg[aria-label="Draw Deck a Gain automation"]');
    await lane.scrollIntoViewIfNeeded();
    const beforeAutomation = await page.evaluate(() => window.mulch.ring().at(-1)?.seq ?? -1);
    const laneBox = await lane.boundingBox();
    if (laneBox === null) throw new Error("automation lane has no browser bounds");
    // Element-relative positions throughout: the page above this lane grows as the smoke runs,
    // and a viewport coordinate measured one gesture ago is a coordinate somewhere else now.
    const at = (fraction, height) => ({
      x: Math.max(2, laneBox.width * fraction),
      y: laneBox.height * height,
    });
    const laneIs = (points) =>
      page.waitForFunction(
        (points) => (window.mulch.probe().decks.a.automation["deck.gain"]?.length ?? 0) === points,
        points,
      );
    // The first point anchors the lane's window, so it goes at the very start: after that commit
    // the time under a given pixel stops moving, and every later gesture can name a position.
    await lane.click({ position: at(0, 0.9) });
    await laneIs(1);
    await lane.click({ position: at(0.6, 0.2) });
    await laneIs(2);
    // Drag that second point somewhere else: one gesture, one whole-lane replacement.
    await lane.hover({ position: at(0.6, 0.2) });
    await page.mouse.down();
    await lane.hover({ position: at(0.8, 0.5) });
    await page.mouse.up();
    await page.waitForFunction(
      () => (window.mulch.probe().decks.a.automation["deck.gain"]?.at(-1)?.value ?? 0) < 1,
    );
    await laneIs(2);
    // The secondary button deletes the point under it, and clicking again puts one back.
    await lane.click({ button: "right", position: at(0.8, 0.5) });
    await laneIs(1);
    await lane.click({ position: at(0.8, 0.5) });
    await laneIs(2);
    const automationEvents = await page.evaluate(
      (after) =>
        window.mulch
          .ring()
          .filter((event) => event.seq > after && event.t === "automation.changed").length,
      beforeAutomation,
    );
    if (automationEvents !== 5) {
      throw new Error(`five automation gestures emitted ${automationEvents} durable changes`);
    }
    await page.getByRole("button", { name: "undo" }).click();
    await laneIs(1);
    await page.getByRole("button", { name: "redo" }).click();
    await laneIs(2);

    // P4 rides the same browser: bypass, reorder and remove through the visible rack controls,
    // each an ordinary command, then undo and redo of that whole sequence. What it leaves behind
    // — one bypassed filter — is what the save, reload and archive assertions below carry.
    const rack = page.getByLabel("Deck a effects");
    await rack.scrollIntoViewIfNeeded();
    const beforeRack = await page.evaluate(() => window.mulch.ring().at(-1)?.seq ?? -1);
    const rackIs = (effects, bypassed) =>
      page.waitForFunction(
        ({ effects, bypassed }) => {
          const deck = window.mulch.probe().decks.a;
          return deck.effects.join(",") === effects && deck.bypassed.join(",") === bypassed;
        },
        { effects, bypassed },
      );
    await rack.getByRole("button", { name: "add Filter" }).click();
    await rack.getByRole("button", { name: "add Delay" }).click();
    await rackIs("filter,delay", "");
    await rack.getByRole("button", { name: "Bypass Filter on deck a" }).click();
    await rackIs("filter,delay", "filter");
    await rack.getByRole("button", { name: "Move Delay earlier on deck a" }).click();
    await rackIs("delay,filter", "filter");
    await rack.getByRole("button", { name: "Remove Delay from deck a" }).click();
    await rackIs("filter", "filter");
    // One press per operation, both ways: a rack edit is one durable transaction (0023).
    await page.getByRole("button", { name: "undo" }).click();
    await rackIs("delay,filter", "filter");
    await page.getByRole("button", { name: "undo" }).click();
    await rackIs("filter,delay", "filter");
    await page.getByRole("button", { name: "redo" }).click();
    await rackIs("delay,filter", "filter");
    await page.getByRole("button", { name: "redo" }).click();
    await rackIs("filter", "filter");
    const rackOps = await page.evaluate(
      (after) =>
        window.mulch
          .ring()
          .filter((event) => event.seq > after)
          .map((event) => event.t),
      beforeRack,
    );

    // P5 rides the same browser: the picker offers an effect's parameter only because its plugin
    // declared automation and the rack holds it, the lane editor is the same one, and Option turns
    // the same knob into a recorded, looping lane — on a bypassed effect, which is still bound
    // and still scheduled (0024).
    const workspace = page.getByLabel("Deck a automation");
    const beforeCutoff = await page.evaluate(() => window.mulch.ring().at(-1)?.seq ?? -1);
    await workspace.getByRole("button", { name: "Automate Cutoff" }).click();
    const cutoffLane = page.locator('svg[aria-label="Draw Deck a Cutoff automation"]');
    await cutoffLane.waitFor();
    const cutoffBox = await cutoffLane.boundingBox();
    if (cutoffBox === null) throw new Error("cutoff lane has no browser bounds");
    await cutoffLane.click({ position: { x: cutoffBox.width * 0.3, y: cutoffBox.height * 0.2 } });
    await page.waitForFunction(
      () => (window.mulch.probe().decks.a.automation["filter.cutoff"]?.length ?? 0) === 1,
    );

    const cutoffKnob = rack.getByRole("slider", { name: "Cutoff" });
    const knobBounds = await cutoffKnob.boundingBox();
    if (knobBounds === null) throw new Error("cutoff knob has no browser bounds");
    const armed = () => page.locator('[data-automation="armed"]').count();
    if ((await armed()) !== 0) throw new Error("a knob was armed before Option was held");
    await page.keyboard.down("Alt");
    // The reveal: every automatable knob, on both decks, and nothing else.
    await page.waitForFunction(
      () => document.querySelectorAll('[data-automation="armed"]').length === 3,
    );
    await page.mouse.move(knobBounds.x + knobBounds.width / 2, knobBounds.y + knobBounds.height / 2);
    await page.mouse.down();
    await page.mouse.move(
      knobBounds.x + knobBounds.width / 2,
      knobBounds.y - 40,
      { steps: 6 },
    );
    await page.mouse.up();
    await page.keyboard.up("Alt");
    await page.waitForFunction(
      () => (window.mulch.probe().decks.a.automation["filter.cutoff"]?.length ?? 0) > 1,
    );
    if ((await armed()) !== 0) throw new Error("a knob stayed armed after Option was released");
    const cutoffOps = await page.evaluate(
      (after) => ({
        events: window.mulch
          .ring()
          .filter((event) => event.seq > after && event.t === "automation.changed")
          .map((event) => event.param),
        lane: window.mulch.probe().decks.a.automation["filter.cutoff"].length,
        // The recorded lane runs against a bypassed effect, which kept its nodes (0023, 0024).
        bypassed: window.mulch.probe().decks.a.bypassed.join(","),
      }),
      beforeCutoff,
    );

    const first = await page.evaluate(async ({ bytes, kept, sessionVersion }) => {
      const instrument = window.mulch;
      const once = (label, test) =>
        new Promise((resolve, reject) => {
          let off = () => {};
          const timeout = setTimeout(() => {
            off();
            reject(new Error(`timed out waiting for ${label}`));
          }, 5_000);
          off = instrument.on((event) => {
            if (!test(event)) return;
            off();
            clearTimeout(timeout);
            resolve(event);
          });
        });
      const file = new File([Uint8Array.from(bytes)], "generated.wav", { type: "audio/wav" });
      const garbage = await instrument.ingest(file);

      const firstSaved = once(
        "first session.saved",
        (event) => event.t === "session.saved" && event.reason === "manual",
      );
      instrument.send({ t: "session.save" });
      await firstSaved;
      instrument.send({ t: "param.set", deck: "a", param: "deck.gain", value: 0.4 });
      instrument.send({ t: "deck.activate", deck: "b" });
      const saved = once(
        "replacement session.saved",
        (event) => event.t === "session.saved" && event.reason === "manual",
      );
      instrument.send({ t: "session.save" });
      await saved;

      const database = await new Promise((resolve, reject) => {
        const request = indexedDB.open("mulch", 1);
        request.addEventListener("success", () => resolve(request.result), { once: true });
        request.addEventListener("error", () => reject(request.error), { once: true });
      });
      const read = (store, key) =>
        new Promise((resolve, reject) => {
          const request = database.transaction(store).objectStore(store).get(key);
          request.addEventListener("success", () => resolve(request.result), { once: true });
          request.addEventListener("error", () => reject(request.error), { once: true });
        });
      const count = (store) =>
        new Promise((resolve, reject) => {
          const request = database.transaction(store).objectStore(store).count();
          request.addEventListener("success", () => resolve(request.result), { once: true });
          request.addEventListener("error", () => reject(request.error), { once: true });
        });
      const stored = await read("blobs", kept);
      const storedBytes = [...new Uint8Array(await stored.arrayBuffer())];
      const removed = await read("blobs", garbage);
      const session = await read("sessions", "current");
      const sessionCount = await count("sessions");

      const refused = once(
        "garbage-collected blob error",
        (event) => event.t === "error" && event.detail.includes(garbage),
      );
      instrument.send({ t: "deck.load", deck: "a", source: { blobId: garbage } });
      await refused;
      return {
        kept,
        bytesEqual: storedBytes.length === bytes.length && storedBytes.every((byte, i) => byte === bytes[i]),
        garbageRemoved: removed === undefined,
        singleton:
          sessionCount === 1 &&
          session.version === sessionVersion &&
          session.activeDeck === "b" &&
          session.decks.a.source.blobId === kept &&
          session.decks.a.params["deck.gain"] === 0.4 &&
          session.decks.a.automation["deck.gain"].length > 1 &&
          session.decks.a.effects.join(",") === "filter" &&
          session.decks.a.bypassed.join(",") === "filter",
        sourceAfterRefusal: instrument.probe().decks.a.source,
      };
    }, { bytes: wav, kept, sessionVersion: CURRENT_SESSION_VERSION });

    await page.reload({ waitUntil: "load" });
    await page.waitForFunction(() => "mulch" in window, undefined, { timeout: 15_000 });
    const restored = await page.evaluate(async (sessionVersion) => {
      const instrument = window.mulch;
      const probe = instrument.probe();
      const before = probe.decks.a;
      const started = Promise.race([
        new Promise((resolve) => {
          const off = instrument.on((event) => {
            if (event.t !== "deck.started" || event.deck !== "a") return;
            off();
            resolve(event);
          });
        }),
        new Promise((_, reject) => {
          setTimeout(() => reject(new Error("timed out waiting for restored deck.started")), 5_000);
        }),
      ]);
      instrument.send({ t: "deck.play", deck: "a" });
      await started;
      instrument.send({ t: "deck.stop", deck: "a" });
      const ring = instrument.ring();
      return {
        before,
        activeDeck: probe.activeDeck,
        restored: ring.some(
          (event) => event.t === "session.restored" && event.version === sessionVersion,
        ),
        gapless: ring.every((event, index) => event.seq === index),
        automation: before.automation["deck.gain"],
      };
    }, CURRENT_SESSION_VERSION);
    // P1 rides this existing browser launch: export through the visible download control, then
    // import through the visible file input in a fresh browser repository.
    const downloadPromise = page.waitForEvent("download");
    await page.getByRole("button", { name: "export session" }).click();
    const download = await downloadPromise;
    const stream = await download.createReadStream();
    const archiveChunks = [];
    for await (const chunk of stream) archiveChunks.push(chunk);
    const archiveBytes = Buffer.concat(archiveChunks);
    const freshContext = await browser.newContext();
    const freshPage = await freshContext.newPage();
    await freshPage.addInitScript(() => {
      window.__MULCH_DRIVE__ = true;
    });
    let portable;
    try {
      await freshPage.goto(url, { waitUntil: "load" });
      await freshPage.waitForFunction(() => "mulch" in window, undefined, { timeout: 15_000 });
      await freshPage.locator('input[aria-label="Import session archive"]').setInputFiles({
        name: `round-trip${SESSION_ARCHIVE_FILE.extension}`,
        mimeType: SESSION_ARCHIVE_FILE.mediaType,
        buffer: archiveBytes,
      });
      await freshPage.waitForFunction(() =>
        window.mulch.ring().some((event) => event.t === "session.imported"),
      );
      portable = await freshPage.evaluate(async ({ kept, bytes, sessionVersion }) => {
        const probe = window.mulch.probe();
        const database = await new Promise((resolve, reject) => {
          const request = indexedDB.open("mulch", 1);
          request.addEventListener("success", () => resolve(request.result), { once: true });
          request.addEventListener("error", () => reject(request.error), { once: true });
        });
        const stored = await new Promise((resolve, reject) => {
          const request = database.transaction("blobs").objectStore("blobs").get(kept);
          request.addEventListener("success", () => resolve(request.result), { once: true });
          request.addEventListener("error", () => reject(request.error), { once: true });
        });
        const storedBytes = [...new Uint8Array(await stored.arrayBuffer())];
        return {
          currentVersion:
            probe.decks.a.source?.blobId === kept &&
            probe.activeDeck === "b" &&
            probe.decks.a.automation["deck.gain"].length > 1 &&
            probe.decks.a.effects.join(",") === "filter" &&
            probe.decks.a.bypassed.join(",") === "filter",
          bytesEqual:
            storedBytes.length === bytes.length && storedBytes.every((byte, index) => byte === bytes[index]),
          imported: window.mulch
            .ring()
            .some((event) => event.t === "session.imported" && event.version === sessionVersion),
          errors: window.mulch.ring().filter((event) => event.t === "error"),
        };
      }, { kept, bytes: wav, sessionVersion: CURRENT_SESSION_VERSION });
    } finally {
      await freshContext.close();
    }
    // M7's parity assertion observes the raw output of the exact OfflineAudioContext that
    // renderOffline builds, then compares every sample with the WAV returned by that render.
    // Intercepting startRendering keeps the test independent of render.ts's encoding branch
    // without constructing a second graph or exposing an AudioBuffer through the facade.
    const parity = await page.evaluate(
      async ({ bits, bytesPerSample, epsilon, headerBytes, secs }) => {
        const original = OfflineAudioContext.prototype.startRendering;
        let graphBuffer;
        OfflineAudioContext.prototype.startRendering = async function () {
          const rendered = await original.call(this);
          graphBuffer = rendered;
          return rendered;
        };

        let result;
        try {
          result = await window.mulch.render({
            secs,
            envelopes: [
              { t: "deck.load", deck: "a", source: { gen: "sine", hz: 733, secs: 0.125 } },
              { t: "param.set", deck: "a", param: "deck.gain", value: 0.37 },
              {
                t: "automation.set",
                deck: "a",
                param: "deck.gain",
                points: [
                  { at: 0, value: 0.1 },
                  { at: 0.12, value: 0.7 },
                ],
              },
              { t: "param.set", deck: "a", param: "deck.pan", value: 0.4 },
              { t: "effect.add", deck: "a", effect: "filter" },
              { t: "param.set", deck: "a", param: "filter.cutoff", value: 3200 },
              { t: "deck.play", deck: "a" },
            ],
            wav: true,
          });
        } finally {
          OfflineAudioContext.prototype.startRendering = original;
        }
        if (graphBuffer === undefined || result.wav === undefined) {
          throw new Error("offline export did not produce both graph samples and a WAV");
        }

        const binary = atob(result.wav);
        const bytes = Uint8Array.from(binary, (character) => character.codePointAt(0) ?? 0);
        const view = new DataView(bytes.buffer);
        const channels = view.getUint16(22, true);
        const sampleRate = view.getUint32(24, true);
        const dataBytes = view.getUint32(40, true);
        const frames = dataBytes / (channels * bytesPerSample);
        if (
          channels !== graphBuffer.numberOfChannels ||
          sampleRate !== graphBuffer.sampleRate ||
          frames !== graphBuffer.length ||
          bytes.length !== headerBytes + dataBytes
        ) {
          throw new Error("exported WAV shape differs from its rendered AudioBuffer");
        }

        let maxDelta = 0;
        let audible = false;
        const negativeScale = 2 ** (bits - 1);
        const positiveScale = negativeScale - 1;
        for (let frame = 0; frame < frames; frame++) {
          for (let channel = 0; channel < channels; channel++) {
            const at = headerBytes + (frame * channels + channel) * bytesPerSample;
            const pcm = view.getInt16(at, true);
            const exported = pcm / (pcm < 0 ? negativeScale : positiveScale);
            const rendered = graphBuffer.getChannelData(channel)[frame] ?? 0;
            const delta = Math.abs(rendered - exported);
            if (delta > maxDelta) maxDelta = delta;
            if (Math.abs(rendered) > 0.01) audible = true;
            if (delta > epsilon) {
              throw new Error(
                `export sample ${channel}:${frame} differs by ${delta}, above ${epsilon}`,
              );
            }
          }
        }
        const rms = (fromSecs, toSecs) => {
          const from = Math.round(fromSecs * sampleRate);
          const to = Math.round(toSecs * sampleRate);
          let sum = 0;
          let count = 0;
          for (let channel = 0; channel < channels; channel++) {
            const data = graphBuffer.getChannelData(channel);
            for (let frame = from; frame < to; frame++) {
              const sample = data[frame] ?? 0;
              sum += sample * sample;
              count++;
            }
          }
          return Math.sqrt(sum / count);
        };
        // Independent of the WAV parity path: these raw graph windows straddle the scheduled
        // gain ramp on a steady sine source, proving the AudioParam lane changed rendered PCM.
        const automationEarlyRms = rms(0.06, 0.08);
        const automationLateRms = rms(0.13, 0.15);
        return { audible, channels, frames, maxDelta, automationEarlyRms, automationLateRms };
      },
      {
        bits: WAV_BITS,
        bytesPerSample: WAV_BYTES_PER_SAMPLE,
        epsilon: WAV_QUANTIZATION_EPSILON,
        headerBytes: WAV_HEADER_BYTES,
        secs: PARITY_RENDER_SECS,
      },
    );
    // P4's offline half, on the existing page: the same rack commands through the same chain,
    // with an automation lane running, and a scheduled bypass that has to change the samples.
    // The render is its own control — the window before the bypass is the filtered one.
    const rackRender = await page.evaluate(async (secs) => {
      const result = await window.mulch.render({
        secs,
        envelopes: [
          { t: "deck.load", deck: "a", source: { gen: "sine", hz: 733, secs: 0.35 } },
          {
            t: "automation.set",
            deck: "a",
            param: "deck.gain",
            points: [
              { at: 0, value: 0.5 },
              { at: secs, value: 0.5 },
            ],
          },
          { t: "effect.add", deck: "a", effect: "filter" },
          { t: "effect.add", deck: "a", effect: "delay" },
          { t: "effect.reorder", deck: "a", effect: "delay", index: 0 },
          { t: "effect.remove", deck: "a", effect: "delay" },
          { t: "param.set", deck: "a", param: "filter.cutoff", value: 200 },
          { t: "deck.play", deck: "a" },
          { at: 0.2, cmd: { t: "effect.bypass", deck: "a", effect: "filter", bypassed: true } },
        ],
      });
      const deck = result.probes.at(-1).probe.decks.a;
      return {
        effects: deck.effects.join(","),
        bypassed: deck.bypassed.join(","),
        events: result.events.map((event) => event.t),
        // 0.1s fingerprint windows: [1] is fully filtered, [2] is after the bypass landed.
        filteredDb: result.fingerprint.rmsDb[1],
        openDb: result.fingerprint.rmsDb[2],
      };
    }, RACK_RENDER_SECS);

    // P5's offline half: the same effect-owned lane through the same chain and the same
    // scheduling, proving a scheduled effect parameter renders as sound and not just as state.
    const cutoffRender = await page.evaluate(async (secs) => {
      const result = await window.mulch.render({
        secs,
        envelopes: [
          { t: "deck.load", deck: "a", source: { gen: "sine", hz: 733, secs } },
          { t: "effect.add", deck: "a", effect: "filter" },
          {
            t: "automation.set",
            deck: "a",
            param: "filter.cutoff",
            points: [
              { at: 0, value: 60 },
              { at: 0.1, value: 60 },
              { at: 0.2, value: 18000 },
              { at: secs, value: 18000 },
            ],
          },
          { t: "deck.play", deck: "a" },
        ],
      });
      return {
        lane: result.probes.at(-1).probe.decks.a.automation["filter.cutoff"].length,
        // 0.1s windows: [0] is under the closed filter, [3] is after the lane opened it.
        closedDb: result.fingerprint.rmsDb[0],
        openDb: result.fingerprint.rmsDb[3],
      };
    }, RACK_RENDER_SECS);

    // P6's offline half: the parametric EQ through the same shared graph, on the same page. One
    // tone, one narrow peak, and two lanes that move independently — the render is its own
    // control, because every window below plays the identical source at the identical deck gain.
    const eqRender = await page.evaluate(async (secs) => {
      const result = await window.mulch.render({
        secs,
        envelopes: [
          { t: "deck.load", deck: "a", source: { gen: "sine", hz: 733, secs } },
          // Quiet enough that an 18dB boost still lands well under the master limiter, so what
          // the windows measure is the EQ and never the bus protecting itself.
          { t: "param.set", deck: "a", param: "deck.gain", value: 0.08 },
          { t: "effect.add", deck: "a", effect: "eq" },
          { t: "param.set", deck: "a", param: "eq.q", value: 8 },
          {
            t: "automation.set",
            deck: "a",
            param: "eq.frequency",
            points: [
              { at: 0, value: 200 },
              { at: 0.2, value: 200 },
              { at: 0.28, value: 733 },
              { at: secs, value: 733 },
            ],
          },
          {
            t: "automation.set",
            deck: "a",
            param: "eq.gain",
            points: [
              { at: 0, value: 18 },
              { at: 0.4, value: 18 },
              { at: 0.45, value: -18 },
              { at: secs, value: -18 },
            ],
          },
          { t: "deck.play", deck: "a" },
        ],
      });
      const deck = result.probes.at(-1).probe.decks.a;
      return {
        effects: deck.effects.join(","),
        lanes: Object.keys(deck.automation).sort().join(","),
        // 0.1s windows. [1]: a full 18dB of boost parked at 200Hz, which a 733Hz tone must not
        // hear — the frequency-selectivity control, and the first window clear of the transport's
        // lookahead silence. [3]: the same boost after the lane swept the peak onto the tone.
        // [5]: the peak still on the tone, with the gain lane now cutting instead.
        awayDb: result.fingerprint.rmsDb[1],
        boostedDb: result.fingerprint.rmsDb[3],
        cutDb: result.fingerprint.rmsDb[5],
      };
    }, EQ_RENDER_SECS);

    return {
      first,
      keyboard,
      rackOps,
      cutoffOps,
      cutoffRender,
      eqRender,
      restored,
      portable,
      parity,
      rackRender,
    };
  } finally {
    await browser.close();
    await server.close();
  }
};

// One build for all three, here rather than three times in there. Drive rebuilds when src/ is
// newer than dist/, which is the right answer for one process and a race for three starting
// together — each would see the same stale dist and write it at the same time. Unconditional:
// the gate is the wrong place to trust an mtime, and the build is ~200ms. The CLI rather than
// `await import("vite")` — pulling vite into this process costs more than the build does.
const built = spawnSync(join(ROOT, "node_modules/.bin/vite"), ["build", "--logLevel", "warn"], {
  cwd: ROOT,
  encoding: "utf8",
});
if (built.status !== 0) fail(`the preview build failed\n${built.stdout}${built.stderr}`);

const [paramRun, deckRun, renderRun, loopClearRun, negative, persistence] = await Promise.all([
  drive("fixtures/param-smoke.jsonl"),
  drive("fixtures/deck-smoke.jsonl"),
  drive("--render", String(RENDER_SECS), "fixtures/render-smoke.jsonl"),
  drive("--render", "1", "--out", exportPath, "fixtures/loop-clear-smoke.jsonl"),
  drive("--expect-no-attach"),
  persistenceSmoke(),
]);

/** Split a finished run's output into the event stream, the probes, and a render's fingerprint. */
const runFixture = (fixture, run) => {
  if (run.status !== 0) fail(`drive ${fixture} exited ${run.status}\n${run.stderr}`);
  const lines = run.stdout
    .split("\n")
    .filter((line) => line !== "")
    .map((line) => JSON.parse(line));
  const events = lines.filter(
    (line) => !("probe" in line) && !("peek" in line) && !("fingerprint" in line),
  );
  // Gapless seq from 0. Drive queues on this side, so a hole can only be the emitter's (§1).
  events.forEach((e, i) => {
    if (e.seq !== i) fail(`${fixture}: seq gap — expected ${i}, saw ${e.seq}`);
  });
  return {
    events,
    probes: lines.filter((line) => "probe" in line).map((line) => line.probe),
    peeks: lines.filter((line) => "peek" in line).map((line) => line.peek),
    fingerprint: lines.findLast((line) => "fingerprint" in line)?.fingerprint,
  };
};

const { events, probes } = runFixture("fixtures/param-smoke.jsonl", paramRun);
const probe = probes.at(-1) ?? fail("no probe on the last line");

// param.set in, param.changed out — including the scheduled one, which only appears if
// drive waited for the clock and pumped the queue before its final probe.
const changed = events.filter((e) => e.t === "param.changed");
const values = (deck) =>
  changed
    .filter((e) => e.deck === deck && e.param === "deck.gain")
    .map((e) => e.value)
    .join(",");
if (values("a") !== "0.5,0.75") fail(`deck a: expected param.changed 0.5,0.75 — saw ${values("a")}`);
if (values("b") !== "1.25") fail(`deck b: expected param.changed 1.25 — saw ${values("b")}`);

// An `at` already in the past is a position in the order, not a missed deadline: the {"at":0}
// line lands with no xrun, because lateness is measured from when the envelope could first run.
const paramXruns = events.filter((e) => e.t === "xrun");
if (paramXruns.length > 0) {
  fail(`param smoke: spurious xrun — ${paramXruns.map((e) => e.detail).join("; ")}`);
}

// probe() agrees with the log — deck a at its scheduled value, not the immediate one.
if (probe.decks.a.params["deck.gain"] !== 0.75) fail("probe: deck a gain is not 0.75");
if (probe.decks.b.params["deck.gain"] !== 1.25) fail("probe: deck b gain is not 1.25");

// ---- M2: sound, asserted by an agent with no ears ----

const deck = runFixture("fixtures/deck-smoke.jsonl", deckRun);
const of = (t, id) => deck.events.filter((e) => e.t === t && (id === undefined || e.deck === id));

// A generated source became a real buffer of the length the command asked for.
const [loaded] = of("deck.loaded", "a");
if (loaded?.duration !== 2) fail(`deck a: expected a 2s buffer — saw ${loaded?.duration}`);

// Both registry plugins append without another transport wait, and their indices make signal
// order observable without exposing graph nodes through probe().
const liveEffects = of("effect.added", "a");
if (
  liveEffects.length !== 2 ||
  liveEffects[0]?.effect !== "filter" ||
  liveEffects[0]?.index !== 0 ||
  liveEffects[1]?.effect !== "delay" ||
  liveEffects[1]?.index !== 1
) {
  fail(`deck a: effects not appended filter → delay — ${JSON.stringify(liveEffects)}`);
}

// Every session write reaches the log, including the loop: an agent reading only the stream
// knows what was applied, without having to ask probe() for it.
const [loopSet] = of("deck.loop.changed", "a");
if (loopSet?.loop?.out !== 0.25) fail(`deck a: loop not on the log — saw ${JSON.stringify(loopSet)}`);

// Playback actually began, and the audio thread — not a main-thread timer — said so.
const [started] = of("deck.started", "a");
if (!started) fail("deck a never started: nothing on the audio clock reported playback");
if (!(liveEffects[1]?.at > started.at)) {
  fail("deck a: delay was not appended after playback began");
}

// Four cycles a second, a second of it, minus the lookahead before the first one. The count
// is a range because it is real time; the sequence is exact, because a dropped cycle is a bug.
const looped = of("deck.looped", "a");
if (looped.length < 3) fail(`deck a: expected at least 3 loop cycles — saw ${looped.length}`);
looped.forEach((e, i) => {
  if (e.cycle !== i + 1) fail(`deck a: loop cycles are not consecutive — saw ${e.cycle} at ${i}`);
});

// Every event carries the audio clock, and the loop reports its own exact boundary rather than
// the moment the main thread noticed: cycle N landed one loop length after the one before it.
const period = 0.25;
looped.forEach((e, i) => {
  const expected = started.at + (i + 1) * period;
  if (Math.abs(e.at - expected) > 0.001) {
    fail(`deck a: cycle ${e.cycle} stamped ${e.at}, expected ${expected.toFixed(3)}`);
  }
});

// The probe taken mid-flight agrees with the log: the graph reported playing, not the command.
const midflight = deck.probes.at(0) ?? fail("deck smoke printed no probe");
if (midflight.decks.a.playing !== true) fail("probe: deck a is not playing mid-fixture");
if (midflight.decks.a.loop?.out !== 0.25) fail("probe: deck a loop was not recorded");
if (midflight.decks.a.effects.join(",") !== "filter,delay") {
  fail(`probe: deck a rack is not filter,delay — ${midflight.decks.a.effects.join(",")}`);
}
if (
  midflight.decks.a.params["filter.cutoff"] !== 8000 ||
  midflight.decks.a.params["delay.time"] !== 0.05 ||
  midflight.decks.a.params["delay.feedback"] !== 0.2 ||
  midflight.decks.a.params["delay.mix"] !== 0.1
) {
  fail("probe: live effect parameters do not match their configured values");
}

// The read channel, through a real graph (0014). Deck a's peek lands mid-loop, so the
// playhead must sit inside the loop; the meter is not asserted — a click train is mostly
// silence, and the analyser window can legitimately fall between clicks. Deck b's peek lands
// mid-sine: a strictly positive playhead and a hot meter, which no dead wiring (zeros) can
// fake — the assertion the Node tests cannot make.
const peekA = deck.peeks.at(0) ?? fail("deck smoke printed no peek for deck a");
if (!(peekA.position >= 0 && peekA.position < 0.25)) {
  fail(`peek: playhead outside the loop — ${JSON.stringify(peekA)}`);
}
const peekB = deck.peeks.at(1) ?? fail("deck smoke printed no peek for deck b");
if (!(peekB.position > 0.05 && peekB.position <= 0.5)) {
  fail(`peek: a playing one-shot's playhead at ${peekB.position}`);
}
if (!(peekB.meter > 0.1)) fail(`peek: a playing sine metered at ${peekB.meter}`);

// Stopping is a command; ending is the source running out. Both reach the log, distinguishably.
if (!of("deck.stopped", "a").some((e) => e.reason === "command")) {
  fail("deck a: deck.stop did not report a stop");
}
if (!of("deck.stopped", "b").some((e) => e.reason === "ended")) {
  fail("deck b: a one-shot source did not report its own end");
}

// A loop too short to report is refused into no loop, visibly. Without the floor this fixture
// does not fail here — it wedges the audio thread and the run times out instead.
const degenerate = of("deck.loop.changed", "b").at(-1);
if (degenerate === undefined || degenerate.loop !== null) {
  fail(`a sub-quantum loop was accepted: ${JSON.stringify(degenerate)}`);
}
if (looped.length > 20) fail(`loop cycles flooded the log: ${looped.length}`);

// No missed deadline anywhere. An xrun is never swallowed, so an unexplained one fails here.
const xruns = of("xrun");
if (xruns.length > 0) fail(`xrun during the smoke: ${xruns.map((e) => e.detail).join("; ")}`);

// ---- M3: what it sounded like, against a golden ----

const render = runFixture("fixtures/render-smoke.jsonl", renderRun);
const print = render.fingerprint ?? fail("the render printed no fingerprint");

// Offline the clock is arithmetic, not a race, so the timing assertions here are exact where
// the live deck's are a tolerance: this is what the deterministic host buys (plan §2).
const cycles = render.events.filter((e) => e.t === "deck.looped" && e.deck === "a");
const [begins] = render.events.filter((e) => e.t === "deck.started" && e.deck === "a");
if (begins?.at !== LOOKAHEAD_SECS) fail(`the render started at ${begins?.at}, not one lookahead in`);
if (cycles.length !== 2) fail(`expected exactly 2 loop cycles offline — saw ${cycles.length}`);
cycles.forEach((e, i) => {
  const expected = begins.at + (i + 1) * 0.25;
  if (e.at !== expected) fail(`cycle ${e.cycle} landed at ${e.at}, not ${expected}`);
});

const renderEffects = render.events.filter((e) => e.t === "effect.added");
if (
  renderEffects.length !== 2 ||
  renderEffects[0]?.deck !== "a" ||
  renderEffects[0]?.effect !== "filter" ||
  renderEffects[0]?.index !== 0 ||
  renderEffects[1]?.deck !== "b" ||
  renderEffects[1]?.effect !== "delay" ||
  renderEffects[1]?.index !== 0
) {
  fail(`render: effect events do not describe filter then delay — ${JSON.stringify(renderEffects)}`);
}

// Asserted whatever the golden says, because a golden is only as good as what was blessed:
// these are the facts the fixture is built to produce, and a bless that lost one is a bug.
if (print.frames !== print.sampleRate * RENDER_SECS) {
  fail(`the render is ${print.frames} frames, not ${RENDER_SECS}s of them`);
}
if (!(print.clicks > 0)) fail("the render has no click onsets — the deck never made a sound");
if (print.peakDb[0] !== print.peakDb[1]) fail(`a centred mono source landed off-centre: ${print.peakDb}`);

// Deck a is the filtered first portion; deck b's source ends at ~1.10s. Audible windows after
// that event can only be delay feedback, and alternating quiet windows pin its 200ms spacing.
if (!print.rmsDb.slice(0, 8).some((db) => db > -80)) {
  fail("the filtered first portion is silent");
}
const delayStopped = render.events.find(
  (e) => e.t === "deck.stopped" && e.deck === "b" && e.reason === "ended",
);
if (!delayStopped) fail("delay source never ended, so its tail cannot be isolated");
const tailWindows = print.rmsDb.slice(Math.ceil(delayStopped.at / 0.1));
if (tailWindows.filter((db) => db > -80).length < 3) {
  fail(`delay tail has fewer than three audible repeats — ${tailWindows}`);
}
if (tailWindows.filter((db) => db === -120).length < 3) {
  fail(`delay tail does not preserve the configured repeat spacing — ${tailWindows}`);
}

const renderProbe = render.probes.at(-1) ?? fail("the render printed no final probe");
if (
  renderProbe.decks.a.effects.join(",") !== "filter" ||
  renderProbe.decks.b.effects.join(",") !== "delay"
) {
  fail("render probe does not preserve the per-deck effect order");
}

// A loop cleared mid-play continues from the playhead rather than rewinding to 0:00. Offline,
// so the resume point is exact arithmetic (see the fixture's header for the numbers): the
// replacement source starts one lookahead after the clear, at the position the loop was at —
// and, unlooped from 0.65 of a 1s buffer, it runs out inside the render, which a deck thrown
// back to 0:00 cannot do in the time left.
const loopClear = runFixture("fixtures/loop-clear-smoke.jsonl", loopClearRun);
const starts = loopClear.events.filter((e) => e.t === "deck.started");
if (starts.length !== 2) fail(`loop-clear: expected 2 starts, saw ${starts.length}`);
const resumed = starts[1];
const clearedAt = 0.4 + LOOKAHEAD_SECS;
if (Math.abs(resumed.at - clearedAt) > 1e-9 || Math.abs(resumed.offset - 0.65) > 1e-9) {
  fail(`loop-clear: resumed at ${resumed.at} from offset ${resumed.offset}, not ${clearedAt} from 0.65`);
}
if (!loopClear.events.some((e) => e.t === "deck.stopped" && e.reason === "ended")) {
  fail("loop-clear: the cleared deck never ran out — it was rewound, not resumed");
}

if (bless) {
  // Written plainly, then handed to the formatter that owns every other file in the repo.
  // oxfmt fills each array onto one line, which is what makes a fingerprint readable in a
  // diff — and formatting it here instead would produce a golden the `format` step rejects.
  writeFileSync(GOLDEN, `${JSON.stringify(print, null, 2)}\n`);
  const formatted = spawnSync(join(ROOT, "node_modules/.bin/oxfmt"), [GOLDEN], { encoding: "utf8" });
  if (formatted.status !== 0) fail(`could not format the golden\n${formatted.stderr}`);
  console.error(`smoke: blessed ${GOLDEN} — read the diff before committing it`);
} else {
  const differences = compareFingerprints(JSON.parse(readFileSync(GOLDEN, "utf8")), print);
  if (differences.length > 0) {
    fail(
      `the render no longer sounds like fixtures/golden/render-smoke.json:\n  ` +
        `${differences.join("\n  ")}\n` +
        "  If the change was meant, reread the diff and rerun with ./scripts/smoke --bless.",
    );
  }
}

// The runtime gate's negative half: a flag-less page has no window.mulch (plan §3).
if (negative.status !== 0) fail(`--expect-no-attach failed\n${negative.stdout}${negative.stderr}`);

if (!persistence.first.bytesEqual) fail("persistence smoke: imported blob bytes changed");
if (!persistence.first.garbageRemoved) fail("persistence smoke: unreferenced blob survived save");
if (!persistence.first.singleton) fail("persistence smoke: current session snapshot was not replaced");
if (
  !persistence.keyboard.editableIgnored ||
  !persistence.keyboard.devRouteIgnored ||
  persistence.keyboard.activeDeck !== "a" ||
  !persistence.keyboard.activatedBoth ||
  !persistence.keyboard.globalAligned ||
  !persistence.keyboard.historyCommands ||
  !persistence.keyboard.historyButtons ||
  !persistence.keyboard.editableUndoIgnored ||
  persistence.keyboard.errors.length > 0
) {
  fail(`keyboard smoke: command path is wrong — ${JSON.stringify(persistence.keyboard)}`);
}
// One press, one durable event, both ways — a rack operation that emitted twice or emitted an
// error would mean the UI is doing something the command model is not (0023).
const rackCount = (t) => persistence.rackOps.filter((kind) => kind === t).length;
if (
  rackCount("effect.added") !== 2 ||
  rackCount("effect.bypass.changed") !== 1 ||
  rackCount("effect.reordered") !== 1 ||
  rackCount("effect.removed") !== 1 ||
  rackCount("history.undone") !== 2 ||
  rackCount("history.redone") !== 2 ||
  rackCount("error") > 0
) {
  fail(`rack smoke: operations did not each emit one durable event — ${persistence.rackOps}`);
}
if (
  persistence.rackRender.effects !== "filter" ||
  persistence.rackRender.bypassed !== "filter" ||
  !persistence.rackRender.events.includes("effect.reordered") ||
  !persistence.rackRender.events.includes("effect.removed") ||
  !persistence.rackRender.events.includes("effect.bypass.changed")
) {
  fail(`offline rack does not match the live one — ${JSON.stringify(persistence.rackRender)}`);
}
// P5: one target list, one editor, one command — and the effect's own lane both on the live
// bypassed rack and through the offline chain (0024).
if (
  persistence.cutoffOps.events.length !== 2 ||
  persistence.cutoffOps.events.some((param) => param !== "filter.cutoff") ||
  persistence.cutoffOps.lane < 2 ||
  persistence.cutoffOps.bypassed !== "filter"
) {
  fail(`effect-owned automation did not commit one lane per gesture — ${JSON.stringify(persistence.cutoffOps)}`);
}
if (
  persistence.cutoffRender.lane !== 4 ||
  persistence.cutoffRender.openDb - persistence.cutoffRender.closedDb < RACK_BYPASS_DB
) {
  fail(
    `a scheduled cutoff lane did not change the offline signal: ${persistence.cutoffRender.closedDb}dB ` +
      `closed, ${persistence.cutoffRender.openDb}dB open`,
  );
}
// P6: the parametric EQ is one registry plugin, so what needs proving in a browser is its sound —
// that its peak is where its frequency says, and that both of its lanes move it independently.
if (persistence.eqRender.effects !== "eq" || persistence.eqRender.lanes !== "eq.frequency,eq.gain") {
  fail(`the EQ render did not arrange the rack it asked for — ${JSON.stringify(persistence.eqRender)}`);
}
if (Math.abs(persistence.eqRender.awayDb - persistence.eqRender.boostedDb) < EQ_BAND_DB) {
  fail(
    `18dB of EQ parked at 200Hz was not selective against a 733Hz tone: ${persistence.eqRender.awayDb}dB ` +
      `away, ${persistence.eqRender.boostedDb}dB with the peak swept onto the tone`,
  );
}
if (persistence.eqRender.boostedDb - persistence.eqRender.cutDb < EQ_BAND_DB) {
  fail(
    `the EQ gain lane did not cut what it had boosted: ${persistence.eqRender.boostedDb}dB boosted, ` +
      `${persistence.eqRender.cutDb}dB cut`,
  );
}
if (persistence.rackRender.openDb - persistence.rackRender.filteredDb < RACK_BYPASS_DB) {
  fail(
    `a bypassed filter did not leave the offline signal path: ${persistence.rackRender.filteredDb}dB ` +
      `filtered, ${persistence.rackRender.openDb}dB after the bypass`,
  );
}
if (persistence.first.sourceAfterRefusal?.blobId !== persistence.first.kept) {
  fail("persistence smoke: failed blob load partially changed the deck");
}
if (
  persistence.restored.before.source?.blobId !== persistence.first.kept ||
  persistence.restored.before.duration <= 0 ||
  persistence.restored.before.playing !== false ||
  persistence.restored.before.params["deck.gain"] !== 0.4 ||
  persistence.restored.before.effects.join(",") !== "filter" ||
  persistence.restored.before.bypassed.join(",") !== "filter" ||
  persistence.restored.automation?.length <= 1
) {
  fail(`persistence smoke: restored deck is wrong — ${JSON.stringify(persistence.restored.before)}`);
}
if (!persistence.restored.restored) fail("persistence smoke: session.restored was not emitted");
if (persistence.restored.activeDeck !== "b") {
  fail("persistence smoke: active deck was not restored");
}
if (!persistence.restored.gapless) fail("persistence smoke: restored event ring has a seq gap");
if (
  !persistence.portable.currentVersion ||
  !persistence.portable.bytesEqual ||
  !persistence.portable.imported ||
  persistence.portable.errors.length > 0
) {
  fail(`portable session smoke: fresh import failed — ${JSON.stringify(persistence.portable)}`);
}
if (!persistence.parity.audible) fail("offline export parity rendered only silence");
if (persistence.parity.channels < 1 || persistence.parity.frames < 1) {
  fail(`offline export parity is empty — ${JSON.stringify(persistence.parity)}`);
}
if (
  !(persistence.parity.automationEarlyRms > 0) ||
  persistence.parity.automationLateRms <= persistence.parity.automationEarlyRms * 1.75
) {
  fail(`offline automation did not raise the rendered gain — ${JSON.stringify(persistence.parity)}`);
}

// The sample comparison covers the public render result; this separately keeps the CLI's
// --out plumbing honest. It rides the existing loop-clear render, so it adds no browser run.
const exported = readFileSync(exportPath);
rmSync(exportDir, { force: true, recursive: true });
const exportView = new DataView(exported.buffer, exported.byteOffset, exported.byteLength);
const exportChannels = exportView.getUint16(22, true);
const exportDataBytes = exportView.getUint32(40, true);
const exportSamples = exportDataBytes / WAV_BYTES_PER_SAMPLE;
const exportIsAudible = Array.from({ length: exportSamples }, (_, index) =>
  exportView.getInt16(WAV_HEADER_BYTES + index * WAV_BYTES_PER_SAMPLE, true),
).some((sample) => sample !== 0);
if (
  exported.subarray(0, 4).toString("ascii") !== "RIFF" ||
  exported.subarray(8, 12).toString("ascii") !== "WAVE" ||
  exported.subarray(36, 40).toString("ascii") !== "data" ||
  exportView.getUint32(4, true) !== exported.length - 8 ||
  exportChannels < 1 ||
  exportView.getUint32(24, true) < 1 ||
  exportDataBytes !== exported.length - WAV_HEADER_BYTES ||
  exportSamples % exportChannels !== 0 ||
  !exportIsAudible
) {
  fail("drive --out did not write a complete, audible PCM WAV");
}

console.log(
  `${events.length} events, gapless; param.changed and probe() agree\n` +
    `${deck.events.length} events from the deck: loaded 2.00s, started, ${looped.length} loop ` +
    `cycles on the audio clock, stopped by command and by ending\n` +
    `${RENDER_SECS}s rendered offline: filter then delay, ${cycles.length} cycles to the sample, ` +
    `${tailWindows.filter((db) => db > -80).length} audible tail windows, fingerprint matches the golden\n` +
    `a loop cleared mid-play resumed from ${resumed.offset.toFixed(2)}, ran out inside the render\n` +
    "rack bypassed, reordered and removed through its controls, undone and redone one press each; " +
    `offline the same rack rose ${(persistence.rackRender.openDb - persistence.rackRender.filteredDb).toFixed(1)}dB when its filter was bypassed\n` +
    "automation targets followed the rack: a point drawn and a knob recorded under Option on the " +
    `filter's own lane, which opened the offline render by ${(persistence.cutoffRender.openDb - persistence.cutoffRender.closedDb).toFixed(1)}dB\n` +
    `the EQ's peak swept onto a 733Hz tone offline: ${(persistence.eqRender.boostedDb - persistence.eqRender.awayDb).toFixed(1)}dB ` +
    `once its frequency lane arrived, ${(persistence.eqRender.boostedDb - persistence.eqRender.cutDb).toFixed(1)}dB back when its gain lane cut\n` +
    "session blob bytes persisted, garbage collected, restored stopped, and played after reload\n" +
    "portable session round-tripped through download and file input into a fresh repository\n" +
    `offline export matches ${persistence.parity.frames * persistence.parity.channels} shared-graph samples ` +
    `within ${WAV_QUANTIZATION_EPSILON} (max ${persistence.parity.maxDelta})\n` +
    "flag-less page has no window.mulch",
);
