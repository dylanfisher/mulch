#!/usr/bin/env node
// The drive step of ./scripts/check — the smoke from plan §3, against the real preview build
// in the real headless Chromium. Three halves: the no-audio one (param.set in, param.changed
// out, a gapless seq, a probe() that agrees, and the attach contract's negative half), the M2
// one (a generated source loads, starts, loops, and grows an effect rack), and the M3/M5 one
// (an offline render whose filter and delay fingerprint still matches a golden). The assertions live
// here so ./scripts/drive stays a transport that knows nothing about decks or params.
//
// This file is the fixture half: it drives ./scripts/drive as a subprocess and reads back what
// each run printed. The browser half — one preview server, one page, and everything M6 and after
// needs a real Chromium for — is scripts/smoke.d/, one file per scenario, each holding its own
// gestures, thresholds, assertions and claim. Adding a behaviour there is one file, not four
// places in one; scripts/smoke.d/browser.js lists the scenarios in the order the page is driven.
//
//   ./scripts/smoke --bless   rewrite the golden fingerprint from this run, for when the
//                             difference is a change you meant. Never run it to make the gate
//                             green: a golden nobody read is a golden that asserts nothing.
//
// The runs are independent, so they go at once. This step is the whole critical path of
// ./scripts/check — everything else finishes underneath it — and the deck fixture spends most
// of its time waiting on real audio time that no amount of CPU shortens. Serially the other
// runs were pure addition; alongside, they are free.
import { spawn, spawnSync } from "node:child_process";
import { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";

import { chromium } from "playwright";

// The one implementation of the tolerances, imported rather than restated: the page computes a
// fingerprint with it and this compares one with it (Node strips the types on the way in).
import { compareFingerprints } from "../src/lib/fingerprint.ts";
// The transport's own lookahead, imported for the same reason: the render's start time is
// asserted against the number the transport schedules with, not a restated 0.05.
import { LOOKAHEAD_SECS } from "../src/audio/transport.ts";
import { WAV_BYTES_PER_SAMPLE, WAV_HEADER_BYTES } from "../src/lib/wav.ts";
import { browserSmoke } from "./smoke.d/browser.js";
import { browserClaims } from "./smoke.d/harness.js";
import { reversedBuffers } from "./smoke.d/reversed.js";

const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), "..");
const bless = process.argv.includes("--bless");
/** How long the render fixture is. Its commands occupy 1.3s; the rest exposes the delay tail. */
const RENDER_SECS = 2;
const GOLDEN = join(ROOT, "fixtures/golden/render-smoke.json");
const exportDir = mkdtempSync(join(tmpdir(), "mulch-export-smoke-"));
const exportPath = join(exportDir, "loop-clear.wav");
process.on("exit", () => rmSync(exportDir, { force: true, recursive: true }));

/**
 * `evidence` is everything the failing assertion had, printed whole. A dB threshold names the two
 * numbers that tripped it, and those two never say whether a window simply landed on an edge —
 * the master bus delays rendered audio against the schedule that made it (DeckReport,
 * src/audio/deck.ts), so a boundary reads shallow while the gesture is perfectly correct. One
 * render costs a build and a Chromium: printing everything once is cheaper than one wrong guess.
 */
const fail = (message, evidence) => {
  console.error(`smoke: ${message}`);
  if (evidence !== undefined) console.error(`  evidence: ${JSON.stringify(evidence)}`);
  process.exit(1);
};

/**
 * One line of the summary a passing run prints, written where the assertions that earned it are
 * rather than in one block at the bottom. The claims print in the order they were made, which is
 * the order the assertions read in. Everything a claim quotes has already been asserted directly
 * above it — a number here that no `fail()` above guards is a number nobody is checking.
 */
const claims = [];
const report = (claim) => claims.push(claim);

// Say "run ./scripts/setup" here, before drive buries playwright's raw "Executable
// doesn't exist" in a buffered log — scripts/check's own guard only probes node_modules.
if (!existsSync(chromium.executablePath())) {
  fail("headless Chromium is not installed — run ./scripts/setup");
}

const drive = (...args) =>
  new Promise((done) => {
    // stdin ignored, not piped: drive reads stdin to EOF whenever it is not a TTY, and an
    // open pipe nobody writes to never reaches one — the run hangs instead of finishing.
    const child = spawn(join(ROOT, "scripts/drive"), args, {
      cwd: ROOT,
      stdio: ["ignore", "pipe", "pipe"],
    });
    let stdout = "";
    let stderr = "";
    child.stdout.setEncoding("utf8").on("data", (d) => (stdout += d));
    child.stderr.setEncoding("utf8").on("data", (d) => (stderr += d));
    child.on("close", (status) => done({ status, stdout, stderr }));
  });

/**
 * The deadline, proved the only way it can be: a run whose input will never arrive. An open pipe
 * nobody writes to is exactly the wedge that once cost an hour — a drive that hangs holds a
 * Chromium and teaches nothing, and no caller can tell it apart from one doing slow work (0036).
 * A second of the gate buys the guarantee that no invocation of this transport can hang.
 */
const stalledDrive = () =>
  new Promise((done) => {
    const child = spawn(join(ROOT, "scripts/drive"), ["--deadline", "1"], {
      cwd: ROOT,
      stdio: ["pipe", "ignore", "pipe"],
    });
    let stderr = "";
    child.stderr.setEncoding("utf8").on("data", (d) => (stderr += d));
    child.on("close", (status) => done({ status, stderr }));
  });

// One build for all three, here rather than three times in there. Drive rebuilds when src/ is
// newer than dist/, which is the right answer for one process and a race for three starting
// together — each would see the same stale dist and write it at the same time. Unconditional:
// the gate is the wrong place to trust an mtime, and the build is ~200ms. The CLI rather than
// `await import("vite")` — pulling vite into this process costs more than the build does.
const built = spawnSync(join(ROOT, "node_modules/.bin/vite"), ["build", "--logLevel", "warn"], {
  cwd: ROOT,
  encoding: "utf8",
});
if (built.status !== 0) fail(`the preview build failed\n${built.stdout}${built.stderr}`);

const [paramRun, deckRun, renderRun, loopClearRun, negative, stalled, reversed, persistence] =
  await Promise.all([
    drive("fixtures/param-smoke.jsonl"),
    drive("fixtures/deck-smoke.jsonl"),
    drive("--render", String(RENDER_SECS), "fixtures/render-smoke.jsonl"),
    drive("--render", "1", "--out", exportPath, "fixtures/loop-clear-smoke.jsonl"),
    drive("--expect-no-attach"),
    stalledDrive(),
    // A browser page of its own, beside the six drive runs rather than on the one serial page:
    // it counts what a jumping yard leaves in the heap, which wants a page nothing has decoded
    // into, and the serial page is the gate's whole critical path (plan §3, P121). Caught for the
    // reason the persistence page is — a throw here would take the runs beside it down with it.
    reversedBuffers(ROOT).catch((error) => ({
      failed: String(error.message ?? error).split("\n")[0],
      evidence: error.evidence,
    })),
    // Caught rather than thrown: the browser half has already printed what it had, and rejecting
    // here would take the six drive runs' assertions down with it — six results nobody asked to
    // lose, for one failure. The sentinel fails the run where the persistence claims are read.
    browserSmoke(ROOT).catch((error) => ({
      failed: String(error.message ?? error).split("\n")[0],
    })),
  ]);

/** Split a finished run's output into the event stream, the probes, and a render's fingerprint. */
const runFixture = (fixture, run) => {
  if (run.status !== 0) fail(`drive ${fixture} exited ${run.status}\n${run.stderr}`);
  const lines = run.stdout
    .split("\n")
    .filter((line) => line !== "")
    .map((line) => JSON.parse(line));
  const events = lines.filter(
    (line) => !("probe" in line) && !("peek" in line) && !("fingerprint" in line),
  );
  // Gapless seq from 0. Drive queues on this side, so a hole can only be the emitter's (§1).
  events.forEach((e, i) => {
    if (e.seq !== i) fail(`${fixture}: seq gap — expected ${i}, saw ${e.seq}`);
  });
  return {
    events,
    probes: lines.filter((line) => "probe" in line).map((line) => line.probe),
    peeks: lines.filter((line) => "peek" in line).map((line) => line.peek),
    fingerprint: lines.findLast((line) => "fingerprint" in line)?.fingerprint,
  };
};

const { events, probes } = runFixture("fixtures/param-smoke.jsonl", paramRun);
const probe = probes.at(-1) ?? fail("no probe on the last line");

// param.set in, param.changed out — including the scheduled one, which only appears if
// drive waited for the clock and pumped the queue before its final probe.
const changed = events.filter((e) => e.t === "param.changed");
const values = (deck) =>
  changed
    .filter((e) => e.deck === deck && e.param === "deck.gain")
    .map((e) => e.value)
    .join(",");
if (values("a") !== "0.5,0.75") fail(`deck a: expected param.changed 0.5,0.75 — saw ${values("a")}`);
if (values("b") !== "1.25") fail(`deck b: expected param.changed 1.25 — saw ${values("b")}`);

// An `at` already in the past is a position in the order, not a missed deadline: the {"at":0}
// line lands with no xrun, because lateness is measured from when the envelope could first run.
const paramXruns = events.filter((e) => e.t === "xrun");
if (paramXruns.length > 0) {
  fail(`param smoke: spurious xrun — ${paramXruns.map((e) => e.detail).join("; ")}`);
}

// probe() agrees with the log — deck a at its scheduled value, not the immediate one.
if (probe.decks.a.params["deck.gain"] !== 0.75) fail("probe: deck a gain is not 0.75");
if (probe.decks.b.params["deck.gain"] !== 1.25) fail("probe: deck b gain is not 1.25");
report(`${events.length} events, gapless; param.changed and probe() agree`);

// ---- M2: sound, asserted by an agent with no ears ----

const deck = runFixture("fixtures/deck-smoke.jsonl", deckRun);
const of = (t, id) => deck.events.filter((e) => e.t === t && (id === undefined || e.deck === id));

// A generated source became a real buffer of the length the command asked for.
const [loaded] = of("deck.loaded", "a");
if (loaded?.duration !== 2) fail(`deck a: expected a 2s buffer — saw ${loaded?.duration}`);

// Both registry plugins append without another transport wait, and their indices make signal
// order observable without exposing graph nodes through probe().
const liveEffects = of("effect.added", "a");
if (
  liveEffects.length !== 2 ||
  liveEffects[0]?.effect !== "filter" ||
  liveEffects[0]?.index !== 0 ||
  liveEffects[1]?.effect !== "delay" ||
  liveEffects[1]?.index !== 1
) {
  fail(`deck a: effects not appended filter → delay — ${JSON.stringify(liveEffects)}`);
}

// Every session write reaches the log, including the loop: an agent reading only the stream
// knows what was applied, without having to ask probe() for it.
const [loopSet] = of("deck.loop.changed", "a");
if (loopSet?.loop?.out !== 0.25) fail(`deck a: loop not on the log — saw ${JSON.stringify(loopSet)}`);

// Playback actually began, and the audio thread — not a main-thread timer — said so.
const [started] = of("deck.started", "a");
if (!started) fail("deck a never started: nothing on the audio clock reported playback");
if (!(liveEffects[1]?.at > started.at)) {
  fail("deck a: delay was not appended after playback began");
}

// Four cycles a second, a second of it, minus the lookahead before the first one. The count
// is a range because it is real time; the sequence is exact, because a dropped cycle is a bug.
const looped = of("deck.looped", "a");
if (looped.length < 3) fail(`deck a: expected at least 3 loop cycles — saw ${looped.length}`);
looped.forEach((e, i) => {
  if (e.cycle !== i + 1) fail(`deck a: loop cycles are not consecutive — saw ${e.cycle} at ${i}`);
});

// Every event carries the audio clock, and the loop reports its own exact boundary rather than
// the moment the main thread noticed: cycle N landed one loop length after the one before it.
const period = 0.25;
looped.forEach((e, i) => {
  const expected = started.at + (i + 1) * period;
  if (Math.abs(e.at - expected) > 0.001) {
    fail(`deck a: cycle ${e.cycle} stamped ${e.at}, expected ${expected.toFixed(3)}`);
  }
});

// The probe taken mid-flight agrees with the log: the graph reported playing, not the command.
const midflight = deck.probes.at(0) ?? fail("deck smoke printed no probe");
if (midflight.decks.a.playing !== true) fail("probe: deck a is not playing mid-fixture");
if (midflight.decks.a.loop?.out !== 0.25) fail("probe: deck a loop was not recorded");
const midRack = midflight.decks.a.effects;
if (midRack.map((entry) => entry.effect).join(",") !== "filter,delay") {
  fail(`probe: deck a rack is not filter,delay — ${JSON.stringify(midRack)}`);
}
// A value lookup is (instance, param): each entry carries its own numbers (0030).
if (
  midRack[0].params["filter.cutoff"] !== 8000 ||
  midRack[1].params["delay.time"] !== 0.05 ||
  midRack[1].params["delay.feedback"] !== 0.2 ||
  midRack[1].params["delay.mix"] !== 0.1
) {
  fail("probe: live instance parameters do not match their configured values");
}

// The read channel, through a real graph (0014). Deck a's peek lands mid-loop, so the
// playhead must sit inside the loop; the meter is not asserted — a click train is mostly
// silence, and the analyser window can legitimately fall between clicks. Deck b's peek lands
// mid-sine: a strictly positive playhead and a hot meter, which no dead wiring (zeros) can
// fake — the assertion the Node tests cannot make.
const peekA = deck.peeks.at(0) ?? fail("deck smoke printed no peek for deck a");
if (!(peekA.position >= 0 && peekA.position < 0.25)) {
  fail(`peek: playhead outside the loop — ${JSON.stringify(peekA)}`);
}
const peekB = deck.peeks.at(1) ?? fail("deck smoke printed no peek for deck b");
if (!(peekB.position > 0.05 && peekB.position <= 0.5)) {
  fail(`peek: a playing one-shot's playhead at ${peekB.position}`);
}
if (!(peekB.meter > 0.1)) fail(`peek: a playing sine metered at ${peekB.meter}`);

// Stopping is a command; ending is the source running out. Both reach the log, distinguishably.
if (!of("deck.stopped", "a").some((e) => e.reason === "command")) {
  fail("deck a: deck.stop did not report a stop");
}
if (!of("deck.stopped", "b").some((e) => e.reason === "ended")) {
  fail("deck b: a one-shot source did not report its own end");
}

// A loop too short to report is refused into no loop, visibly. Without the floor this fixture
// does not fail here — it wedges the audio thread and the run times out instead.
const degenerate = of("deck.loop.changed", "b").at(-1);
if (degenerate === undefined || degenerate.loop !== null) {
  fail(`a sub-quantum loop was accepted: ${JSON.stringify(degenerate)}`);
}
if (looped.length > 20) fail(`loop cycles flooded the log: ${looped.length}`);

// No missed deadline anywhere. An xrun is never swallowed, so an unexplained one fails here.
const xruns = of("xrun");
if (xruns.length > 0) fail(`xrun during the smoke: ${xruns.map((e) => e.detail).join("; ")}`);

report(
  `${deck.events.length} events from the deck: loaded 2.00s, started, ${looped.length} loop ` +
    `cycles on the audio clock, stopped by command and by ending`,
);

// ---- M3: what it sounded like, against a golden ----

const render = runFixture("fixtures/render-smoke.jsonl", renderRun);
const print = render.fingerprint ?? fail("the render printed no fingerprint");

// Offline the clock is arithmetic, not a race, so the timing assertions here are exact where
// the live deck's are a tolerance: this is what the deterministic host buys (plan §2).
const cycles = render.events.filter((e) => e.t === "deck.looped" && e.deck === "a");
const [begins] = render.events.filter((e) => e.t === "deck.started" && e.deck === "a");
if (begins?.at !== LOOKAHEAD_SECS) fail(`the render started at ${begins?.at}, not one lookahead in`);
if (cycles.length !== 2) fail(`expected exactly 2 loop cycles offline — saw ${cycles.length}`);
cycles.forEach((e, i) => {
  const expected = begins.at + (i + 1) * 0.25;
  if (e.at !== expected) fail(`cycle ${e.cycle} landed at ${e.at}, not ${expected}`);
});

const renderEffects = render.events.filter((e) => e.t === "effect.added");
if (
  renderEffects.length !== 2 ||
  renderEffects[0]?.deck !== "a" ||
  renderEffects[0]?.effect !== "filter" ||
  renderEffects[0]?.index !== 0 ||
  renderEffects[1]?.deck !== "b" ||
  renderEffects[1]?.effect !== "delay" ||
  renderEffects[1]?.index !== 0
) {
  fail(`render: effect events do not describe filter then delay — ${JSON.stringify(renderEffects)}`);
}

// Asserted whatever the golden says, because a golden is only as good as what was blessed:
// these are the facts the fixture is built to produce, and a bless that lost one is a bug.
if (print.frames !== print.sampleRate * RENDER_SECS) {
  fail(`the render is ${print.frames} frames, not ${RENDER_SECS}s of them`);
}
if (!(print.clicks > 0)) fail("the render has no click onsets — the deck never made a sound");
if (print.peakDb[0] !== print.peakDb[1]) fail(`a centred mono source landed off-centre: ${print.peakDb}`);

// Deck a is the filtered first portion; deck b's source ends at ~1.10s. Audible windows after
// that event can only be delay feedback, and alternating quiet windows pin its 200ms spacing.
if (!print.rmsDb.slice(0, 8).some((db) => db > -80)) {
  fail("the filtered first portion is silent", print.rmsDb);
}
const delayStopped = render.events.find(
  (e) => e.t === "deck.stopped" && e.deck === "b" && e.reason === "ended",
);
if (!delayStopped) fail("delay source never ended, so its tail cannot be isolated");
const tailWindows = print.rmsDb.slice(Math.ceil(delayStopped.at / 0.1));
if (tailWindows.filter((db) => db > -80).length < 3) {
  fail(`delay tail has fewer than three audible repeats — ${tailWindows}`);
}
if (tailWindows.filter((db) => db === -120).length < 3) {
  fail(`delay tail does not preserve the configured repeat spacing — ${tailWindows}`);
}

const renderProbe = render.probes.at(-1) ?? fail("the render printed no final probe");
if (
  renderProbe.decks.a.effects.map((entry) => entry.effect).join(",") !== "filter" ||
  renderProbe.decks.b.effects.map((entry) => entry.effect).join(",") !== "delay"
) {
  fail("render probe does not preserve the per-deck effect order");
}

// A loop cleared mid-play continues from the playhead rather than rewinding to 0:00. Offline,
// so the resume point is exact arithmetic (see the fixture's header for the numbers): the
// replacement source starts one lookahead after the clear, at the position the loop was at —
// and, unlooped from 0.65 of a 1s buffer, it runs out inside the render, which a deck thrown
// back to 0:00 cannot do in the time left.
const loopClear = runFixture("fixtures/loop-clear-smoke.jsonl", loopClearRun);
const starts = loopClear.events.filter((e) => e.t === "deck.started");
if (starts.length !== 2) fail(`loop-clear: expected 2 starts, saw ${starts.length}`);
const resumed = starts[1];
const clearedAt = 0.4 + LOOKAHEAD_SECS;
if (Math.abs(resumed.at - clearedAt) > 1e-9 || Math.abs(resumed.offset - 0.65) > 1e-9) {
  fail(`loop-clear: resumed at ${resumed.at} from offset ${resumed.offset}, not ${clearedAt} from 0.65`);
}
if (!loopClear.events.some((e) => e.t === "deck.stopped" && e.reason === "ended")) {
  fail("loop-clear: the cleared deck never ran out — it was rewound, not resumed");
}
report(`a loop cleared mid-play resumed from ${resumed.offset.toFixed(2)}, ran out inside the render`);

if (bless) {
  // Written plainly, then handed to the formatter that owns every other file in the repo.
  // oxfmt fills each array onto one line, which is what makes a fingerprint readable in a
  // diff — and formatting it here instead would produce a golden the `format` step rejects.
  writeFileSync(GOLDEN, `${JSON.stringify(print, null, 2)}\n`);
  const formatted = spawnSync(join(ROOT, "node_modules/.bin/oxfmt"), [GOLDEN], { encoding: "utf8" });
  if (formatted.status !== 0) fail(`could not format the golden\n${formatted.stderr}`);
  console.error(`smoke: blessed ${GOLDEN} — read the diff before committing it`);
} else {
  const differences = compareFingerprints(JSON.parse(readFileSync(GOLDEN, "utf8")), print);
  if (differences.length > 0) {
    fail(
      `the render no longer sounds like fixtures/golden/render-smoke.json:\n  ` +
        `${differences.join("\n  ")}\n` +
        "  If the change was meant, reread the diff and rerun with ./scripts/smoke --bless.",
    );
  }
}
// The golden half of the claim is made in whichever branch actually made it: a blessed run
// compared nothing, and saying it matched would be the summary's one lie.
report(
  `${RENDER_SECS}s rendered offline: filter then delay, ${cycles.length} cycles to the sample, ` +
    `${tailWindows.filter((db) => db > -80).length} audible tail windows, ` +
    `${bless ? "fingerprint blessed, not compared" : "fingerprint matches the golden"}`,
);

// The runtime gate's negative half: a flag-less page has no window.mulch (plan §3).
if (negative.status !== 0) fail(`--expect-no-attach failed\n${negative.stdout}${negative.stderr}`);
report("flag-less page has no window.mulch");

// Nothing here may hang: a run waiting on input that never comes dies at its deadline naming
// the stage it died in, rather than holding a browser until a human notices it (0036).
const gaveUp = /gave up after 1s while (.+) —/.exec(stalled.stderr);
if (stalled.status === 0 || gaveUp === null) {
  fail(`a stalled drive did not stop at its deadline — exited ${stalled.status}\n${stalled.stderr}`);
}
report(`a drive given input that never came gave up at its deadline while ${gaveUp[1]}`);

// The browser half's own claims, appended where its result is read rather than where they were
// made: they are written while the six drive runs above are still going, and the summary reads
// in the order the assertions do (scripts/smoke.d/harness.js).
if (reversed?.failed !== undefined) {
  fail(`reversed-buffer smoke: ${reversed.failed}`, reversed.evidence);
}
if (persistence?.failed !== undefined) {
  fail(`persistence smoke: ${persistence.failed} — the page's ring and probe are printed above`);
}
claims.push(...browserClaims);

// The sample comparison covers the public render result; this separately keeps the CLI's
// --out plumbing honest. It rides the existing loop-clear render, so it adds no browser run.
const exported = readFileSync(exportPath);
rmSync(exportDir, { force: true, recursive: true });
const exportView = new DataView(exported.buffer, exported.byteOffset, exported.byteLength);
const exportChannels = exportView.getUint16(22, true);
const exportDataBytes = exportView.getUint32(40, true);
const exportSamples = exportDataBytes / WAV_BYTES_PER_SAMPLE;
const exportIsAudible = Array.from({ length: exportSamples }, (_, index) =>
  exportView.getInt16(WAV_HEADER_BYTES + index * WAV_BYTES_PER_SAMPLE, true),
).some((sample) => sample !== 0);
if (
  exported.subarray(0, 4).toString("ascii") !== "RIFF" ||
  exported.subarray(8, 12).toString("ascii") !== "WAVE" ||
  exported.subarray(36, 40).toString("ascii") !== "data" ||
  exportView.getUint32(4, true) !== exported.length - 8 ||
  exportChannels < 1 ||
  exportView.getUint32(24, true) < 1 ||
  exportDataBytes !== exported.length - WAV_HEADER_BYTES ||
  exportSamples % exportChannels !== 0 ||
  !exportIsAudible
) {
  fail("drive --out did not write a complete, audible PCM WAV");
}
report("drive --out wrote a complete, audible PCM WAV");

console.log(claims.join("\n"));
