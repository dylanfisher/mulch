{
  "permissions": {
    "allow": [
      "Bash(./scripts/arch)",
      "Bash(./scripts/check)",
      "Bash(./scripts/dev:*)",
      "Bash(./scripts/drive:*)",
      "Bash(./scripts/setup)",
      "Bash(./scripts/test:*)",
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm build)",
      "Bash(pnpm oxlint:*)",
      "Bash(pnpm oxfmt:*)",
      "Bash(pnpm tsc:*)",
      "Bash(pnpm vitest:*)",
      "Bash(pnpm dlx shadcn@latest add:*)"
    ],
    "deny": [
      "Bash(kill:*)",
      "Bash(killall:*)",
      "Bash(pkill:*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.development)",
      "Read(.env.staging)",
      "Read(.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.*.local)"
    ]
  }
}
